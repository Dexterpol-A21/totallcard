---
// Footer Component
---

<footer id="contacto" class="bg-[#1A1C1C] text-white pt-16 pb-8 px-6">
    <div class="max-w-[1280px] mx-auto grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10">
        <!-- Logo & About -->
        <div class="lg:col-span-1">
            <div class="mb-6 block">
                <div class="flex items-center">
                    <!-- Icono Tarjeta (Izquierda) -->
                    <img src="/images/logoIconNoF.png" alt="Icono Tarjeta" class="h-8 md:h-10 object-contain brightness-0 invert -mt-1 mr-2 md:mr-3 relative z-30" />
                    <!-- Texto con flechas -->
                    <div class="flex flex-col items-center justify-center -space-y-7 brightness-0 invert">
                        <img src="/icons/flechaLogo.svg" alt="" class="h-12 md:h-16 relative z-20 w-[180px] md:w-[240px]" />
                        <img src="/images/logoTextoNoF.PNG" alt="TotallCard" class="h-10 md:h-12 object-contain relative z-10" />
                        <img src="/icons/flechaLogo.svg" alt="" class="h-12 md:h-16 rotate-180 relative z-20 w-[180px] md:w-[240px]" />
                    </div>
                </div>
            </div>
            <p class="font-sans text-white/70 text-[13px] leading-relaxed mb-6">
                Impresión de identidad.<br/>Conexión de confianza.
            </p>
            <div class="flex gap-4">
                <a href="#" class="text-white hover:text-corporate-red transition-colors">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.469h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.469h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
                </a>
                <a href="#" class="text-white hover:text-corporate-red transition-colors">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>
                </a>
                <a href="#" class="text-white hover:text-corporate-red transition-colors">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
