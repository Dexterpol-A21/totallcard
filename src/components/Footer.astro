    </div>

    <!-- Copyright -->
    <div class="max-w-[1280px] mx-auto mt-16 pt-8 border-t border-white/10 flex flex-col md:flex-row justify-between items-center gap-4 text-center md:text-left">
        <div class="font-sans text-white/50 text-[11px] leading-relaxed">
            <p class="mb-1">&copy; 2026 TOTALLCARD. | Envíos a toda la República Mexicana.</p>
            <p class="text-[9px] text-white/30">*Soft Restaurant® y National Soft® son marcas registradas y se mencionan únicamente con fines informativos. No existe afiliación o patrocinio directo.</p>
        </div>
        </p>
        <div class="flex gap-6 font-sans text-white/50 text-[11px]">
            <a href="/privacidad" class="hover:text-white transition-colors">Aviso de privacidad</a>
            <a href="/politicas" class="hover:text-white transition-colors">Términos y condiciones</a>
        </div>
