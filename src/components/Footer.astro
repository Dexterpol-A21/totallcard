---
// Footer Component
---

<footer id="contacto" class="bg-[#1A1C1C] text-white pt-16 pb-8 px-6">
    <div class="max-w-[1280px] mx-auto grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10">
        <!-- Logo & About -->
        <div class="lg:col-span-1">
            <div class="mb-6 block">
                <div class="flex items-center">
                    <!-- Icono Tarjeta (Izquierda) -->
                    <img src="/images/logoIconNoF.webp" alt="Icono Tarjeta" class="h-8 md:h-10 object-contain brightness-0 invert -mt-1 mr-2 md:mr-3 relative z-30" loading="lazy" decoding="async" width="107" height="113" />
                    <!-- Texto con flechas -->
                    <div class="flex flex-col items-center justify-center -space-y-7 brightness-0 invert">
                        <img src="/icons/flechaLogo.svg" alt="" class="h-12 md:h-16 relative z-20 w-[180px] md:w-[240px]" loading="lazy" decoding="async" />
                        <img src="/images/logoTextoNoF.webp" alt="TotallCard" class="h-10 md:h-12 object-contain relative z-10" loading="lazy" decoding="async" width="418" height="110" />
                        <img src="/icons/flechaLogo.svg" alt="" class="h-12 md:h-16 rotate-180 relative z-20 w-[180px] md:w-[240px]" loading="lazy" decoding="async" />
                    </div>
                </div>
            </div>
            <p class="font-sans text-white/70 text-[13px] leading-relaxed mb-6">
                Impresión de identidad.<br/>Conexión de confianza.
            </p>
        </div>

        <!-- Tarjetas -->
        <div class="lg:col-span-1">
            <h4 class="font-sans font-bold uppercase tracking-wider text-xs mb-6 text-white">Tarjetas</h4>
            <ul class="space-y-3 font-sans text-[13px] text-white/70">
                <li><a href="/gafetes-empresariales" class="hover:text-corporate-red transition-colors">Gafetes Empresariales</a></li>
                <li><a href="/gafetes-escolares" class="hover:text-corporate-red transition-colors">Credencial Escolar</a></li>
                <li><a href="/tarjetas-de-membresia" class="hover:text-corporate-red transition-colors">Tarjetas de Membresía</a></li>
                <li><a href="/tarjetas-de-lealtad" class="hover:text-corporate-red transition-colors">Tarjetas de Lealtad</a></li>
                <li><a href="/tarjetas-qr" class="hover:text-corporate-red transition-colors">Tarjetas con QR</a></li>
                <li><a href="/tarjetas-rfid" class="hover:text-corporate-red transition-colors">Tarjetas RFID / NFC</a></li>
                <li><a href="/pases-vip" class="hover:text-corporate-red transition-colors">Credenciales para Eventos</a></li>
            </ul>
        </div>

        <!-- Impresoras y Equipo -->
        <div class="lg:col-span-1">
            <h4 class="font-sans font-bold uppercase tracking-wider text-xs mb-6 text-white">Impresoras y Equipo</h4>
            <ul class="space-y-3 font-sans text-[13px] text-white/70">
                <li><a href="/impresoras" class="hover:text-corporate-red transition-colors">Venta de Impresoras</a></li>
                <li><a href="/cintas-y-consumibles" class="hover:text-corporate-red transition-colors">Cintas y Consumibles</a></li>
                <li><a href="/portagafetes-y-lanyards" class="hover:text-corporate-red transition-colors">Portagafetes y Lanyards</a></li>
            </ul>
        </div>

        <!-- Servicios -->
        <div class="lg:col-span-1">
            <h4 class="font-sans font-bold uppercase tracking-wider text-xs mb-6 text-white">Servicios</h4>
            <ul class="space-y-3 font-sans text-[13px] text-white/70">
                <li><a href="/mantenimiento" class="hover:text-corporate-red transition-colors">Mantenimiento de Equipos</a></li>
                <li><a href="/soporte" class="hover:text-corporate-red transition-colors">Soporte Técnico</a></li>
                <li><a href="/renta" class="hover:text-corporate-red transition-colors">Renta de Equipos</a></li>
            </ul>
        </div>

        <!-- Empresa / Contacto -->
        <div class="lg:col-span-1">
            <h4 class="font-sans font-bold uppercase tracking-wider text-xs mb-6 text-white">Empresa</h4>
            <ul class="space-y-4 font-sans text-[13px] text-white/70">
                <li><a href="/quienes-somos" class="hover:text-corporate-red transition-colors flex items-center gap-2">¿Quiénes Somos?</a></li>
                <li><a href="/faq" class="hover:text-corporate-red transition-colors flex items-center gap-2">Preguntas Frecuentes</a></li>
                <li><a href="/sectores" class="hover:text-corporate-red transition-colors flex items-center gap-2">Sectores Atendidos</a></li>
                <li class="pt-2 border-t border-white/10 mt-2">
                    <div class="flex items-center gap-3 text-white w-fit mt-4">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-corporate-red"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                        Envíos a toda la República Mexicana
                    </div>
                </li>
                <li>
                    <a href="https://wa.me/525615429492" target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 hover:text-[#25D366] transition-colors group cursor-pointer w-fit pt-2">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#25D366]"><path d="M3 21l1.65-3.8a9 9 0 1 1 3.4 2.9L3 21" /><path d="M9 10a.5.5 0 0 0 1 0V9a.5.5 0 0 0-1 0v1a5 5 0 0 0 5 5h1a.5.5 0 0 0 0-1h-1a.5.5 0 0 0 0 1" /></svg>
                        <span class="font-bold">56 1542 9492</span>
                    </a>
                </li>
            </ul>
