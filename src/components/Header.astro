---
const { active = "", submenu = "none" } = Astro.props;

const tarjetasTokens = [
  { label: 'GAFETES EMPRESARIALES', href: '/gafetes-empresariales', icon: '<path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4z"></path><path d="M16 14H8c-2.67 0-8 1.34-8 4v2h24v-2c0-2.66-5.33-4-8-4z"></path>' },
  { label: 'CREDENCIAL ESCOLAR', href: '/gafetes-escolares', icon: '<path d="M12 3L1 9l4 2.18v6L12 21l7-3.82v-6l2-1.09V17h2V9L12 3z"></path>' },
  { label: 'TARJETAS DE MEMBRESÍA', href: '/tarjetas-de-membresia', icon: '<path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>' },
  { label: 'TARJETAS DE LEALTAD', href: '/tarjetas-de-lealtad', icon: '<path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>' },
  { label: 'TARJETAS CON QR', href: '/tarjetas-qr', icon: '<rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect>' },
  { label: 'TARJETAS RFID / NFC', href: '/tarjetas-rfid', icon: '<path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1"/>' },
  { label: 'CREDENCIALES PARA EVENTOS', href: '/pases-vip', icon: '<rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line>' }
];

const equiposTokens = [
  { label: 'IMPRESORAS', href: '/impresoras', icon: '<polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect width="12" height="8" x="6" y="14"/>' },
  { label: 'CINTAS Y CONSUMIBLES', href: '/cintas-y-consumibles', icon: '<path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/>' },
  { label: 'PORTAGAFETES Y LANYARDS', href: '/portagafetes-y-lanyards', icon: '<rect x="6" y="4" width="12" height="16" rx="2"/><circle cx="12" cy="7" r="1"/><path d="M9 11h6"/><path d="M9 15h4"/>' }
];

const empresaTokens = [
  { label: 'INICIO', href: '/', icon: '<path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>' },
  { label: 'QUIÉNES SOMOS', href: '/quienes-somos', icon: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/>' },
  { label: 'PREGUNTAS FRECUENTES', href: '/faq', icon: '<circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/>' },
  { label: 'SECTORES ATENDIDOS', href: '/sectores', icon: '<rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>' }
];

const serviciosTokens = [
  { label: 'MANTENIMIENTO DE EQUIPOS', href: '/mantenimiento', icon: '<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>' },
  { label: 'SOPORTE TÉCNICO', href: '/soporte', icon: '<path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/>' },
  { label: 'RENTA DE EQUIPOS', href: '/renta', icon: '<rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>' }
];

const currentSubmenu = submenu === 'tarjetas' ? tarjetasTokens : submenu === 'equipos' ? equiposTokens : submenu === 'empresa' ? empresaTokens : submenu === 'servicios' ? serviciosTokens : [];
---

<header class="hidden lg:block fixed top-0 w-full bg-white z-50 shadow-sm border-b border-gray-200">
    <!-- Main Top Navigation -->
    <div class="max-w-[1280px] mx-auto px-6 h-20 flex items-center justify-between">
        <a href="/" class="flex items-center">
            <!-- Icono Tarjeta -->
            <img src="/images/logoIconNoF.webp" alt="Icono Tarjeta" class="w-auto h-8 md:h-10 object-contain -mt-1 -mr-5 md:-mr-8 relative z-30" width="107" height="113" />
            <!-- Texto con flechas -->
            <div class="flex flex-col items-center justify-center -space-y-7 group-hover:scale-105 transition-transform duration-500">
                <img src="/icons/flechaLogoRojo.svg" alt="" class="h-12 md:h-16 object-contain relative z-20 w-[180px] md:w-[240px]" width="180" height="64" />
                <img src="/images/logoTextoNoF.webp" alt="TotallCard Cards Printers" class="w-auto h-10 md:h-12 object-contain relative z-10" width="418" height="110" />
                <img src="/icons/flechaLogoRojo.svg" alt="" class="h-12 md:h-16 object-contain rotate-180 relative z-20 w-[180px] md:w-[240px]" width="180" height="64" />
            </div>
        </a>
        
        <!-- Main Navigation (Siempre la misma) -->
        <nav class="hidden lg:flex lg:absolute lg:left-1/2 lg:-translate-x-1/2 gap-2 font-sans font-semibold text-[13px] tracking-wider uppercase text-deep-charcoal">
            <a href="/tarjetas-de-lealtad" class={`nav-item hover:text-white relative px-4 py-2 z-10 transition-colors duration-500 ${submenu === 'tarjetas' ? 'text-corporate-red' : ''}`}>Tarjetas</a>
            <a href="/impresoras" class={`nav-item hover:text-white relative px-4 py-2 z-10 transition-colors duration-500 ${submenu === 'equipos' ? 'text-corporate-red' : ''}`}>Impresoras y Equipo</a>
            <a href="/mantenimiento" class={`nav-item hover:text-white relative px-4 py-2 z-10 transition-colors duration-500 ${submenu === 'servicios' ? 'text-corporate-red' : ''}`}>Servicios</a>
            <a href="/quienes-somos" class={`nav-item hover:text-white relative px-4 py-2 z-10 transition-colors duration-500 ${submenu === 'empresa' ? 'text-corporate-red' : ''}`}>Empresa</a>
        </nav>

        <a href="https://wa.me/525615429492" class="download-button hidden md:inline-flex mt-1">
            <div class="docs">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21l1.65-3.8a9 9 0 1 1 3.4 2.9L3 21" /><path d="M9 10a.5.5 0 0 0 1 0V9a.5.5 0 0 0-1 0v1a5 5 0 0 0 5 5h1a.5.5 0 0 0 0-1h-1a.5.5 0 0 0 0 1" /></svg>
                <span class="tracking-wider uppercase">COTIZACIÓN</span>
            </div>
            <div class="download">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/></svg>
            </div>
        </a>
    </div>

    <!-- Sub-menu (Scrollable on small screens) -->
    {submenu !== "none" && (
        <div class="hidden lg:block border-t border-gray-100 bg-white">
            <div class="max-w-[1280px] mx-auto px-6 overflow-x-auto no-scrollbar">
                <nav class="flex items-center justify-start lg:justify-center gap-6 lg:gap-6 xl:gap-8 w-max lg:w-full text-[11px] lg:text-[8.5px] xl:text-[10px] font-sans font-bold text-gray-500 uppercase tracking-wide pr-6 lg:pr-0 mx-auto">
                    {currentSubmenu.map(token => (
                        <a href={token.href} class={`relative flex items-center gap-1.5 lg:gap-1 xl:gap-2 hover:text-corporate-red transition-colors whitespace-nowrap py-3.5 after:content-[''] after:absolute after:left-0 after:bottom-0 after:h-[2px] after:bg-corporate-red after:transition-all after:duration-300 ${active === token.label ? 'text-corporate-red after:w-full' : 'after:w-0 hover:after:w-full'}`}>
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5 lg:w-3 lg:h-3 xl:w-3.5 xl:h-3.5" set:html={token.icon}></svg>
                            <span>{token.label}</span>
                        </a>
                    ))}
                </nav>
            </div>
        </div>
    )}
</header>

<!-- Menú Inferior Flotante App (Exclusivo para móviles) -->
<div class="lg:hidden fixed bottom-0 left-0 w-full z-[60] flex flex-col shadow-[0_-5px_15px_rgba(0,0,0,0.05)]">
    <!-- Submenú Inferior -->
    {submenu !== "none" && (
        <div class="w-full bg-gray-50/95 backdrop-blur border-t border-gray-200 overflow-x-auto no-scrollbar">
            <nav class="flex items-center justify-start gap-5 w-max px-4 py-2.5 text-[10px] font-sans font-bold text-gray-500 uppercase tracking-wider">
                {currentSubmenu.map(token => (
                    <a href={token.href} class={`flex items-center gap-1.5 transition-colors whitespace-nowrap ${active === token.label ? 'text-corporate-red' : 'hover:text-corporate-red'}`}>
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5" set:html={token.icon}></svg>
                        <span>{token.label}</span>
                    </a>
                ))}
            </nav>
        </div>
    )}
    
    <!-- Menú Principal Inferior -->
    <nav class="w-full bg-white border-t border-gray-200 flex justify-between items-center px-1 py-1" style="padding-bottom: max(0.25rem, env(safe-area-inset-bottom));">
        <a href="/tarjetas-de-lealtad" class={`flex flex-col items-center justify-center w-1/4 py-2 gap-1.5 transition-colors ${submenu === 'tarjetas' ? 'text-corporate-red' : 'text-slate-500 hover:text-deep-charcoal'}`}>
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect><line x1="1" y1="10" x2="23" y2="10"></line></svg>
            <span class="text-[9px] font-bold uppercase tracking-wider">Tarjetas</span>
        </a>
        <a href="/impresoras" class={`flex flex-col items-center justify-center w-1/4 py-2 gap-1.5 transition-colors ${submenu === 'equipos' ? 'text-corporate-red' : 'text-slate-500 hover:text-deep-charcoal'}`}>
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect width="12" height="8" x="6" y="14"/></svg>
            <span class="text-[9px] font-bold uppercase tracking-wider">Equipos</span>
        </a>
        <a href="/mantenimiento" class={`flex flex-col items-center justify-center w-1/4 py-2 gap-1.5 transition-colors ${submenu === 'servicios' ? 'text-corporate-red' : 'text-slate-500 hover:text-deep-charcoal'}`}>
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
            <span class="text-[9px] font-bold uppercase tracking-wider">Servicios</span>
        </a>
        <a href="/" class="flex flex-col items-center justify-center w-1/4 py-2 gap-1.5 transition-colors text-slate-500 hover:text-deep-charcoal">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
            <span class="text-[9px] font-bold uppercase tracking-wider">Inicio</span>
        </a>
        <a href="/quienes-somos" class={`flex flex-col items-center justify-center w-1/4 py-2 gap-1.5 transition-colors ${submenu === 'empresa' ? 'text-corporate-red' : 'text-slate-500 hover:text-deep-charcoal'}`}>
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/><path d="M8 14h.01"/><path d="M12 14h.01"/><path d="M16 14h.01"/><path d="M8 18h.01"/><path d="M12 18h.01"/><path d="M16 18h.01"/></svg>
            <span class="text-[9px] font-bold uppercase tracking-wider">Empresa</span>
        </a>
    </nav>
</div>

<!-- Botón Flotante Whatsapp (Móvil) -->
<a href="https://wa.me/525615429492" target="_blank" rel="noopener noreferrer" class="lg:hidden fixed right-4 w-14 h-14 bg-[#25D366] text-white rounded-full flex items-center justify-center shadow-[0_8px_20px_rgba(37,211,102,0.4)] z-[50] hover:scale-105 transition-transform" style="bottom: calc(125px + env(safe-area-inset-bottom));">
    <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21l1.65-3.8a9 9 0 1 1 3.4 2.9L3 21" /><path d="M9 10a.5.5 0 0 0 1 0V9a.5.5 0 0 0-1 0v1a5 5 0 0 0 5 5h1a.5.5 0 0 0 0-1h-1a.5.5 0 0 0 0 1" /></svg>
</a>

<style is:global>
@media (max-width: 1023px) {
    body {
        /* Deja espacio abajo para que el contenido no quede tapado por la barra móvil y el submenú */
        padding-bottom: calc(115px + env(safe-area-inset-bottom)) !important;
    }
}

.no-scrollbar::-webkit-scrollbar {
    display: none;
}
.no-scrollbar {
    -ms-overflow-style: none;  /* IE and Edge */
    scrollbar-width: none;  /* Firefox */
}

/* ---- HOVER MENU EFECTO FINAL ---- */
.nav-item {
  position: relative; transition: 0.5s ease; padding: 0.5rem 1rem; z-index: 1; text-transform: uppercase; border-radius: 4px;
}
.nav-item::before {
  content: ""; position: absolute; left: 0; bottom: 0; height: 2px; width: 0; background-color: #e1061a; transition: 0.5s ease; border-radius: 4px;
}
.nav-item:hover { color: #fff !important; transition-delay: 0.5s; }
.nav-item:hover::before { width: 100%; }
.nav-item::after { 
  content: ""; position: absolute; left: 0; bottom: 0; height: 0; width: 100%; background-color: #e1061a; transition: 0.4s ease; z-index: -1; border-radius: 4px;
}
.nav-item:hover::after { height: 100%; transition-delay: 0.4s; }

/* ---- DOWNLOAD BUTTON (COTIZACIÓN) ---- */
.download-button {
  position: relative; border-width: 0; color: white; font-size: 13px; font-weight: 600; border-radius: 4px; z-index: 1;
}
.download-button .docs {
  display: flex; align-items: center; justify-content: center; gap: 0.5rem; min-height: 38px; padding: 0.5rem 1.25rem; border-radius: 4px; z-index: 1; background-color: #e1061a; transition: transform 0.5s cubic-bezier(0.77, 0, 0.175, 1);
}
.download {
  position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; max-width: 90%; margin: 0 auto; z-index: -1; border-radius: 4px; transform: translateY(0%); background-color: #25D366; border: solid 1px #25D366; transition: transform 0.5s cubic-bezier(0.77, 0, 0.175, 1);
}
.download-button:hover .download { transform: translateY(100%); }
</style>