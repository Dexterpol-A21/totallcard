---
const { active = "", submenu = "none" } = Astro.props;

const tarjetasTokens = [
  { label: 'GAFETES EMPRESARIALES', href: '/gafetes-empresariales', icon: '<path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4z"></path><path d="M16 14H8c-2.67 0-8 1.34-8 4v2h24v-2c0-2.66-5.33-4-8-4z"></path>' },
  { label: 'CREDENCIAL ESCOLAR', href: '/credenciales-escolares', icon: '<path d="M12 3L1 9l4 2.18v6L12 21l7-3.82v-6l2-1.09V17h2V9L12 3z"></path>' },
  { label: 'TARJETAS DE MEMBRESÍA', href: '/#', icon: '<path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>' },
  { label: 'TARJETAS DE LEALTAD', href: '/#', icon: '<path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>' },
  { label: 'TARJETAS CON QR', href: '/#', icon: '<rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect>' },
  { label: 'TARJETAS RFID / NFC', href: '/#', icon: '<path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1"/>' },
  { label: 'CREDENCIALES PARA EVENTOS', href: '/#', icon: '<rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line>' }
];

const currentSubmenu = submenu === 'tarjetas' ? tarjetasTokens : [];
---

<header class="fixed top-0 w-full bg-white z-50 shadow-sm border-b border-gray-200">
    <!-- Main Top Navigation -->
    <div class="max-w-[1280px] mx-auto px-6 h-20 flex items-center justify-between">
        <a href="/" class="flex items-center">
            <!-- Icono Tarjeta -->
            <img src="/images/logoIconNoF.png" alt="Icono Tarjeta" class="h-8 md:h-10 object-contain -mt-1 -mr-5 md:-mr-8 relative z-30" />
            <!-- Texto con flechas -->
            <div class="flex flex-col items-center justify-center -space-y-7 group-hover:scale-105 transition-transform duration-500">
                <img src="/icons/flechaLogoRojo.svg" alt="" class="h-12 md:h-16 relative z-20 w-[180px] md:w-[240px]" />
                <img src="/images/logoTextoNoF.PNG" alt="TotallCard Cards Printers" class="h-10 md:h-12 object-contain relative z-10" />
                <img src="/icons/flechaLogoRojo.svg" alt="" class="h-12 md:h-16 rotate-180 relative z-20 w-[180px] md:w-[240px]" />
            </div>
        </a>
        
        <!-- Main Navigation (Siempre la misma) -->
        <nav class="hidden lg:flex lg:absolute lg:left-1/2 lg:-translate-x-1/2 gap-2 font-sans font-semibold text-[13px] tracking-wider uppercase text-deep-charcoal">
            <a href="/gafetes-empresariales" class="nav-item text-corporate-red hover:text-white relative px-4 py-2 z-10 transition-colors duration-500">Tarjetas</a>
            <a href="/#impresoras" class="nav-item hover:text-white relative px-4 py-2 z-10 transition-colors duration-500">Impresoras y Equipo</a>
            <a href="/#servicios" class="nav-item hover:text-white relative px-4 py-2 z-10 transition-colors duration-500">Servicios</a>
            <a href="/#empresa" class="nav-item hover:text-white relative px-4 py-2 z-10 transition-colors duration-500">Empresa</a>
        </nav>

        <a href="https://wa.me/5211234567890" class="download-button hidden md:inline-flex mt-1">
            <div class="docs">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21l1.65-3.8a9 9 0 1 1 3.4 2.9L3 21" /><path d="M9 10a.5.5 0 0 0 1 0V9a.5.5 0 0 0-1 0v1a5 5 0 0 0 5 5h1a.5.5 0 0 0 0-1h-1a.5.5 0 0 0 0 1" /></svg>
                <span class="tracking-wider uppercase">COTIZACIÓN</span>
            </div>
            <div class="download">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/></svg>
            </div>
        </a>
    </div>

    <!-- Sub-menu (Scrollable on small screens) -->
    {submenu !== "none" && (
        <div class="border-t border-gray-100 bg-white">
            <div class="max-w-[1280px] mx-auto px-6 overflow-x-auto no-scrollbar">
                <nav class="flex items-center gap-6 lg:gap-0 justify-between w-full min-w-max text-[10px] md:text-[11px] font-sans font-bold text-gray-500 uppercase tracking-wide">
                    {currentSubmenu.map(token => (
                        <a href={token.href} class={`relative flex items-center gap-2 hover:text-corporate-red transition-colors whitespace-nowrap py-3.5 after:content-[''] after:absolute after:left-0 after:bottom-0 after:h-[2px] after:bg-corporate-red after:transition-all after:duration-300 ${active === token.label ? 'text-corporate-red after:w-full' : 'after:w-0 hover:after:w-full'}`}>
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={token.icon}></svg>
                            <span>{token.label}</span>
                        </a>
                    ))}
                </nav>
            </div>
        </div>
    )}
</header>

<style is:global>
.no-scrollbar::-webkit-scrollbar {
    display: none;
}
.no-scrollbar {
    -ms-overflow-style: none;  /* IE and Edge */
    scrollbar-width: none;  /* Firefox */
}

/* ---- HOVER MENU EFECTO FINAL ---- */
.nav-item {
  position: relative; transition: 0.5s ease; padding: 0.5rem 1rem; z-index: 1; text-transform: uppercase; border-radius: 4px;
}
.nav-item::before {
  content: ""; position: absolute; left: 0; bottom: 0; height: 2px; width: 0; background-color: #e1061a; transition: 0.5s ease; border-radius: 4px;
}
.nav-item:hover { color: #fff !important; transition-delay: 0.5s; }
.nav-item:hover::before { width: 100%; }
.nav-item::after { 
  content: ""; position: absolute; left: 0; bottom: 0; height: 0; width: 100%; background-color: #e1061a; transition: 0.4s ease; z-index: -1; border-radius: 4px;
}
.nav-item:hover::after { height: 100%; transition-delay: 0.4s; }

/* ---- DOWNLOAD BUTTON (COTIZACIÓN) ---- */
.download-button {
  position: relative; border-width: 0; color: white; font-size: 13px; font-weight: 600; border-radius: 4px; z-index: 1;
}
.download-button .docs {
  display: flex; align-items: center; justify-content: center; gap: 0.5rem; min-height: 38px; padding: 0.5rem 1.25rem; border-radius: 4px; z-index: 1; background-color: #e1061a; transition: transform 0.5s cubic-bezier(0.77, 0, 0.175, 1);
}
.download {
  position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; max-width: 90%; margin: 0 auto; z-index: -1; border-radius: 4px; transform: translateY(0%); background-color: #25D366; border: solid 1px #25D366; transition: transform 0.5s cubic-bezier(0.77, 0, 0.175, 1);
}
.download-button:hover .download { transform: translateY(100%); }
</style>