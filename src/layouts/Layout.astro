---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const { 
	title = "TOTALLCARD | Impresión de Identidad. Conexión de Confianza.",
	description = "Impresión de Identidad. Conexión de Confianza. TOTALLCARD ofrece credenciales de alta seguridad para escuelas, residenciales y compatibilidad total con Soft Restaurant."
} = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href="/favicon/favicon-96x96.png" sizes="96x96" />
		<link rel="icon" type="image/svg+xml" href="/favicon/favicon.svg" />
		<link rel="shortcut icon" href="/favicon/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png" />
		<link rel="manifest" href="/favicon/site.webmanifest" />
		
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&family=Work+Sans:wght@700;800&display=swap" rel="stylesheet">
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class="bg-light-gray font-sans text-deep-charcoal antialiased selection:bg-corporate-red selection:text-white">
		<slot />
	</body>
</html>
