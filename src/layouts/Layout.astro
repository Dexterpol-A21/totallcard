---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
	keywords?: string;
	image?: string;
	canonical?: string;
}

const { 
	title = "Impresión de Gafetes PVC y Credenciales de Seguridad | TOTALLCARD",
	description = "Impresión de Identidad. Conexión de Confianza. TOTALLCARD ofrece credenciales de alta seguridad para escuelas, residenciales y compatibilidad total con Soft Restaurant.",
	keywords = "credenciales, PVC, gafetes, tarjetas de lealtad, identificación, TotallCard, impresión de tarjetas",
	image = "/images/cards-hero.webp",
	canonical = Astro.url ? Astro.url.href : "https://totallcard.com"
} = Astro.props;
---

<!doctype html>
<html lang="es" class="overflow-x-hidden">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href="/favicon/favicon-96x96.webp" sizes="96x96" />
		<link rel="icon" type="image/svg+xml" href="/favicon/favicon.svg" />
		<link rel="shortcut icon" href="/favicon/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.webp" />
		<link rel="manifest" href="/favicon/site.webmanifest" />
		
		<!-- Elementos LCP críticos precargados -->
		<link rel="preload" href="/images/heroNoF.webp" as="image" type="image/webp" fetchpriority="high" />
		<link rel="preload" href="/images/logoTextoNoF.webp" as="image" type="image/webp" />

		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link rel="preload" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&amp;family=Work+Sans:wght@700;800&amp;display=swap" as="style">
                <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&amp;family=Work+Sans:wght@700;800&amp;display=swap" media="print" onload="this.media='all'">
                <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&amp;family=Work+Sans:wght@700;800&amp;display=swap"></noscript>
		<!-- Basic SEO -->
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="keywords" content={`${keywords}, Querétaro, impresión de credenciales en Querétaro, gafetes escolares Querétaro`} />
		<meta name="generator" content={Astro.generator} />
		<link rel="canonical" href={canonical} />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonical} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={new URL(image, Astro.url)} />

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={canonical} />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description} />
		<meta property="twitter:image" content={new URL(image, Astro.url)} />

	</head>
	<body class="bg-light-gray font-sans text-deep-charcoal antialiased selection:bg-corporate-red selection:text-white overflow-x-hidden w-full relative">
		<slot />
		
		<!-- Botones flotantes (WhatsApp, Facebook, Instagram) -->
		<!-- Agrupados para mostrarse unificados y con el mismo hover/diseño tanto en móvil como en PC -->
		<div class="fixed z-[999] flex flex-col gap-3 right-4 lg:right-6 bottom-[calc(135px+env(safe-area-inset-bottom))] lg:bottom-6">
			<a href="https://www.facebook.com/totallcardmexico" target="_blank" rel="noopener noreferrer" 
			   class="w-14 h-14 bg-[#1877F2] text-white rounded-full flex items-center justify-center shadow-[0_8px_20px_rgba(24,119,242,0.4)] hover:scale-105 transition-transform" aria-label="Síguenos en Facebook">
				<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="currentColor" stroke="none"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.469h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.469h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
			</a>
			<a href="https://www.instagram.com/totallcardmexico/" target="_blank" rel="noopener noreferrer" 
			   class="w-14 h-14 bg-gradient-to-tr from-[#FFDC80] via-[#F56040] to-[#833AB4] text-white rounded-full flex items-center justify-center shadow-[0_8px_20px_rgba(225,48,108,0.4)] hover:scale-105 transition-transform" aria-label="Síguenos en Instagram">
				<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
			</a>
			<a href="https://wa.me/525615429492" target="_blank" rel="noopener noreferrer" 
			   class="lg:hidden w-14 h-14 bg-[#25D366] text-white rounded-full flex items-center justify-center shadow-[0_8px_20px_rgba(37,211,102,0.4)] hover:scale-105 transition-transform" aria-label="Cotizar por WhatsApp">
				<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21l1.65-3.8a9 9 0 1 1 3.4 2.9L3 21" /><path d="M9 10a.5.5 0 0 0 1 0V9a.5.5 0 0 0-1 0v1a5 5 0 0 0 5 5h1a.5.5 0 0 0 0-1h-1a.5.5 0 0 0 0 1" /></svg>
			</a>
		</div>
	</body>
</html>
