---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Lanyard from '../components/Lanyard.jsx';
import Footer from '../components/Footer.astro';
---

<Layout 
        title="Cintas y Consumibles para Credenciales | TOTALLCARD" 
        description="El alma de tus impresiones. Ribbons YMCKO, monocromáticos, tarjetas de PVC, y kits de limpieza para todas las marcas de impresoras."
        keywords="cintas para impresoras, ribbons YMCKO, consumibles credenciales, tarjetas pvc en blanco, kits de limpieza impresoras"
>
        <!-- Lanyard global CTA -->
        <div class="hidden lg:flex fixed inset-0 z-[100] pointer-events-none w-screen h-screen">
            <Lanyard client:visible position={[0, 0, 45]} gravity={[0, -40, 0]} />
        </div>
        <Header submenu="equipos" active="CINTAS Y CONSUMIBLES" />
	<!-- Hero Section: Centro de Impresión -->
	<section class="lg:min-h-[85vh] flex items-start lg:items-center pt-8 pb-8 lg:pt-40 md:pb-12 px-6 bg-slate-50 relative overflow-hidden">
		<div class="max-w-[1280px] mx-auto grid md:grid-cols-2 gap-8 items-center w-full relative z-10">
			<div>
				<p class="font-headings text-corporate-red font-bold text-xs md:text-sm tracking-widest uppercase mb-4 flex items-center gap-2">
                    <span class="w-8 h-[2px] bg-corporate-red"></span>
					Rendimiento y Calidad Original
				</p>
				<h1 class="font-headings font-extrabold text-4xl md:text-5xl lg:text-6xl text-deep-charcoal leading-[1.1] mb-6">
					Cintas y Consumibles Originales
				</h1>
				<p class="font-sans text-base md:text-lg text-medium-gray mb-6 max-w-xl leading-relaxed">
					Garantiza la máxima calidad y extiende la vida útil de tus equipos. Contamos con stock inmediato para las principales marcas del mercado.
				</p>
				
				<div class="flex flex-col sm:flex-row gap-6 mb-6 items-center">
					<a href="https://wa.me/525615429492" class="download-button inline-flex">
						<div class="docs py-3 px-6">
							<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21l1.65-3.8a9 9 0 1 1 3.4 2.9L3 21" /><path d="M9 10a.5.5 0 0 0 1 0V9a.5.5 0 0 0-1 0v1a5 5 0 0 0 5 5h1a.5.5 0 0 0 0-1h-1a.5.5 0 0 0 0 1" /></svg>
							<span class="font-bold text-[15px] tracking-wider uppercase">COTIZAR STOCK</span>
						</div>
						<div class="download">
							<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/></svg>
						</div>
					</a>
					<a href="#catalogo" class="more-button inline-flex">
						<div class="docs py-3 px-6">
							<span class="font-bold text-[15px] tracking-wider uppercase">VER OPCIONES</span>
						</div>
						<div class="download">
							<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
						</div>
					</a>
				</div>
			</div>
			
			<div class="relative w-full h-[400px] md:h-[550px] bg-white rounded-3xl shadow-[0_20px_50px_-12px_rgba(0,0,0,0.1)] border border-slate-100 p-2 overflow-hidden flex flex-col items-center justify-center">
                <picture class="contents">
    <source srcset="/images/consumiblespag.avif" type="image/avif" />
    <source srcset="/images/consumiblespag.webp" type="image/webp" />
    <img src="/images/consumiblespag.png" alt="Consumibles y cintas para impresión" class="w-full h-full object-cover rounded-2xl" />
</picture>
			</div>
		</div>
	</section>


        </section>

    <!-- Aplicaciones / A quién va dirigido -->
    <section class="py-10 md:py-12 px-6 bg-slate-50 border-b border-light-gray/40">
        <div class="max-w-[1280px] mx-auto">
            <div class="text-center max-w-2xl mx-auto mb-12">
                <div class="flex items-center justify-center gap-3 mb-3">
                    <div class="w-12 h-[2px] bg-corporate-red"></div>
                    <span class="font-sans font-bold text-xs tracking-widest text-corporate-red uppercase">Aplicaciones</span>
                </div>
                <h2 class="font-headings font-bold text-3xl md:text-4xl text-deep-charcoal mb-4">Suministros para cada impresión</h2>
                <p class="font-sans text-medium-gray">Todo lo que necesitas para asegurar la máxima durabilidad y definición de color en cada credencial emitida.</p>
            </div>
            
            <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
                <!-- Sector 1 -->
                <div class="bg-white rounded-2xl p-8 hover:-translate-y-1 transition-transform border border-slate-100 flex flex-col items-center text-center shadow-sm">
                    <div class="w-16 h-16 bg-slate-50 rounded-full flex items-center justify-center mb-4 text-corporate-red">
                        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M4 22V2a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v20"/><path d="M14 22v-6H10v6"/><path d="M8 6h.01"/><path d="M12 6h.01"/><path d="M16 6h.01"/><path d="M8 10h.01"/><path d="M12 10h.01"/><path d="M16 10h.01"/><path d="M8 14h.01"/><path d="M12 14h.01"/><path d="M16 14h.01"/></svg>
                    </div>
                    <h4 class="font-headings font-bold text-deep-charcoal mb-2">Cintas / Ribbons</h4>
                    <p class="font-sans text-xs text-slate-500">Cintas YMCKO a color y monocromáticas de excelente calibración y rendimiento exacto.</p>
                </div>
                <!-- Sector 2 -->
                <div class="bg-white rounded-2xl p-8 hover:-translate-y-1 transition-transform border border-slate-100 flex flex-col items-center text-center shadow-sm">
                    <div class="w-16 h-16 bg-slate-50 rounded-full flex items-center justify-center mb-4 text-corporate-red">
                        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>
                    </div>
                    <h4 class="font-headings font-bold text-deep-charcoal mb-2">Tarjetas de PVC</h4>
                    <p class="font-sans text-xs text-slate-500">Tarjetas en blanco premium, con chip o banda magnética totalmente listas para imprimir.</p>
                </div>
                <!-- Sector 3 -->
                <div class="bg-white rounded-2xl p-8 hover:-translate-y-1 transition-transform border border-slate-100 flex flex-col items-center text-center shadow-sm">
                    <div class="w-16 h-16 bg-slate-50 rounded-full flex items-center justify-center mb-4 text-corporate-red">
                        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                    </div>
                    <h4 class="font-headings font-bold text-deep-charcoal mb-2">Kits de Limpieza</h4>
                    <p class="font-sans text-xs text-slate-500">Hisopos, plumones y tarjetas adhesivas para proteger y limpiar cabezales térmicos.</p>
                </div>
                <!-- Sector 4 -->
                <div class="bg-white rounded-2xl p-8 hover:-translate-y-1 transition-transform border border-slate-100 flex flex-col items-center text-center shadow-sm">
                    <div class="w-16 h-16 bg-slate-50 rounded-full flex items-center justify-center mb-4 text-corporate-red">
                        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/><path d="M8 14h.01"/><path d="M12 14h.01"/><path d="M16 14h.01"/><path d="M8 18h.01"/><path d="M12 18h.01"/><path d="M16 18h.01"/></svg>
                    </div>
                    <h4 class="font-headings font-bold text-deep-charcoal mb-2">Eventos y Exposiciones</h4>
                    <p class="font-sans text-xs text-slate-500">Emisión rápida de gafetes para expositores, visitantes y staff.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Qué puedes hacer con ella / Feature Showcase -->
    <section class="py-20 bg-white px-6 overflow-hidden">
        <div class="max-w-[1280px] mx-auto">
            <div class="grid md:grid-cols-2 gap-16 items-center">
                <!-- Izquierda: Teatro CSS / Imagen de Impresora -->
                <div class="relative w-full aspect-square md:aspect-auto md:h-[600px] flex items-center justify-center p-8 overflow-visible">
                    
                    <!-- Animación Custom de Cintas / Ribbon -->
                    <div class="relative z-10 w-full h-full min-h-[400px] flex items-center justify-center">

                        <!-- Cinta de color extendida (Ribbon YMCKO) -->
                        <div class="absolute w-[240px] md:w-[300px] h-[70px] top-1/2 -translate-y-1/2 left-1/2 -translate-x-1/2 overflow-hidden opacity-95 shadow-[0_15px_30px_-5px_rgba(236,72,153,0.4)] z-10">
                            <!-- Patrón continuo YMCKO duplicado exactamente a la mitad para que el bucle encaje perfecto al hacer translateX(-50%) -->
                            <div class="w-[200%] h-full animate-stream-ribbon bg-[linear-gradient(to_right,#fde047_0%,#ec4899_10%,#06b6d4_20%,#1e293b_30%,#e2e8f0_40%,#fde047_50%,#ec4899_60%,#06b6d4_70%,#1e293b_80%,#e2e8f0_90%,#fde047_100%)]"></div>
                            <!-- Overlay estético para simular textura -->
                            <div class="absolute inset-0 bg-white/10 mix-blend-overlay pointer-events-none"></div>
                        </div>
                        
                        <!-- Rollo Izquierdo (Suministro) -->
                        <div class="absolute left-[10%] md:left-[15%] top-1/2 -translate-y-1/2 w-28 h-28 bg-white rounded-full shadow-2xl border-[6px] border-slate-50 flex items-center justify-center z-20 animate-spin-slow">
                            <div class="absolute inset-0 rounded-full border-4 border-dashed border-slate-200 m-2"></div>
                            <div class="w-8 h-8 rounded-full border-[5px] border-slate-800 bg-corporate-red"></div>
                        </div>

                        <!-- Rollo Derecho (Recogida) -->
                        <div class="absolute right-[10%] md:right-[15%] top-1/2 -translate-y-1/2 w-28 h-28 bg-slate-800 rounded-full shadow-2xl border-[6px] border-slate-700 flex items-center justify-center z-20 animate-spin-slow">
                            <div class="absolute inset-0 rounded-full border-4 border-dashed border-slate-600 m-2"></div>
                            <div class="w-8 h-8 rounded-full border-[5px] border-slate-500 bg-deep-charcoal"></div>
                        </div>

                        <!-- Tarjeta PVC emergiendo (Consumible) -->
                        <div class="absolute left-1/2 -translate-x-1/2 bottom-[10%] w-[200px] h-[130px] bg-white rounded-xl shadow-2xl p-5 border border-slate-100 z-30 transform hover:-translate-y-2 transition-transform duration-300 flex flex-col justify-start overflow-hidden">
                            <!-- Reflejo holográfico ligado al ribbon duplicado para el bucle continuo -->
                            <div class="absolute top-0 left-0 w-[200%] h-full opacity-[0.15] bg-[linear-gradient(to_right,#fde047_0%,#ec4899_10%,#06b6d4_20%,#1e293b_30%,#e2e8f0_40%,#fde047_50%,#ec4899_60%,#06b6d4_70%,#1e293b_80%,#e2e8f0_90%,#fde047_100%)] animate-stream-ribbon pointer-events-none"></div>
                            
                            <div class="w-12 h-12 rounded-full shadow-inner bg-slate-800 mb-3 ml-auto flex items-center justify-center text-white relative z-10">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                            </div>
                            <div class="w-2/3 h-2 bg-slate-200 rounded mb-2 relative z-10"></div>
                            <div class="w-1/2 h-2 bg-slate-100 rounded relative z-10"></div>
                        </div>

                        <style>
                            @keyframes stream-ribbon {
                                0% { transform: translateX(0); }
                                100% { transform: translateX(-50%); }
                            }
                            .animate-stream-ribbon { animation: stream-ribbon 5s linear infinite; }
                            
                            @keyframes spin-slow {
                                0% { transform: translateY(-50%) rotate(0deg); }
                                100% { transform: translateY(-50%) rotate(360deg); }
                            }
                            .animate-spin-slow { animation: spin-slow 6s linear infinite; }
                        </style>
                    </div>
                </div>

                <!-- Derecha: Texto y Capacidades -->
                <div>
                    <div class="flex items-center gap-3 mb-4">
                        <span class="w-10 h-[2px] bg-corporate-red"></span>
                        <span class="font-headings font-bold text-xs tracking-[0.2em] text-corporate-red uppercase">Soporte Continuo</span>
                    </div>
                    <h2 class="font-headings font-extrabold text-3xl md:text-5xl text-deep-charcoal mb-6 leading-tight">
                        La mejor calidad de <span class="text-corporate-red">impresión</span>
                    </h2>
                    <p class="font-sans text-slate-500 mb-10 text-lg leading-relaxed">
                        Utilizar cintas originales y consumibles certificados asegura colores precisos, credenciales resistentes y protege el cabezal de tu equipo. Insumos diseñados para el máximo rendimiento.
                    </p>

                    <div class="space-y-6">
                        <!-- Feature 1 -->
                        <div class="flex gap-4">
                            <div class="w-12 h-12 rounded-full bg-red-50 flex items-center justify-center shrink-0 text-corporate-red">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M12 2v20"/><path d="m17 5-5-3-5 3"/><path d="m7 19 5 3 5-3"/></svg>
                            </div>
                            <div>
                                <h4 class="font-headings font-bold text-xl text-deep-charcoal mb-1">Rendimiento Constante</h4>
                                <p class="font-sans text-sm text-slate-500">Nuestros suministros originales te garantizan que puedas imprimir la cantidad exacta de tarjetas sin paros, arrugas o averías del cabezal.</p>
                            </div>
                        </div>
                        
                        <!-- Feature 2 -->
                        <div class="flex gap-4">
                            <div class="w-12 h-12 rounded-full bg-red-50 flex items-center justify-center shrink-0 text-corporate-red">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                            </div>
                            <div>
                                <h4 class="font-headings font-bold text-xl text-deep-charcoal mb-1">Stock Disponible Inmediato</h4>
                                <p class="font-sans text-sm text-slate-500">Olvídate de la escasez. Contamos con líneas de entrega y distribución inmediatas para que nunca te falte cinta ni tarjetas de PVC.</p>
                            </div>
                        </div>

                        <!-- Feature 3 -->
                        <div class="flex gap-4">
                            <div class="w-12 h-12 rounded-full bg-red-50 flex items-center justify-center shrink-0 text-corporate-red">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="m16 10-4 4-4-4"/></svg>
                            </div>
                            <div>
                                <h4 class="font-headings font-bold text-xl text-deep-charcoal mb-1">Calidad Edge-to-Edge</h4>
                                <p class="font-sans text-sm text-slate-500">Cintas Ribbon de colores hiper realistas y tarjetas PVC premium para resultados profesionales libres de desprendimientos o decoloración con el tiempo.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Ecosistema Completo (Tarjetas Detalladas) -->
    <section id="catalogo" class="py-24 bg-slate-50 px-6">
        <div class="max-w-[1280px] mx-auto">
            <div class="text-center max-w-2xl mx-auto mb-16">
                <div class="flex items-center justify-center gap-3 mb-4">
                    <div class="w-12 h-[2px] bg-corporate-red"></div>
                    <span class="font-sans font-bold text-xs tracking-widest text-corporate-red uppercase">Suministros Garantizados</span>
                    <div class="w-12 h-[2px] bg-corporate-red"></div>
                </div>
                <h2 class="font-headings font-bold text-3xl md:text-4xl text-deep-charcoal mb-4">Todo para tu Centro de Credencialización</h2>
            </div>
            
            <div class="max-w-6xl mx-auto">
                
                <!-- Encabezado Principal -->
                <div class="bg-gradient-to-br from-deep-charcoal to-[#1a1a24] rounded-3xl p-0 border border-gray-100/10 shadow-lg mb-8 flex flex-col md:flex-row overflow-hidden text-white relative">
                    <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(#fff 1px, transparent 1px); background-size: 20px 20px;"></div>
                    
                    <div class="p-8 md:p-10 md:w-3/5 relative z-10 flex flex-col justify-center">
                        <div class="flex items-center gap-3 mb-4">
                            <span class="font-sans font-bold text-xs tracking-widest text-corporate-red uppercase">Compatibilidad Universal</span>
                        </div>
                        <h3 class="font-headings font-bold text-2xl md:text-3xl mb-4">Los Ribbons Exactos para tu Equipo</h3>
                        <p class="font-sans text-sm md:text-base text-slate-300 leading-relaxed max-w-lg">
                            Ya sea que busques cintas monocromáticas simples, rollos YMCKO completos o retransferencia de alta seguridad con laminación holográfica para marcas como Zebra, Evolis o Datacard, tenemos el repuesto genuino.
                        </p>
                    </div>
                    <div class="w-full md:w-2/5 min-h-[200px] bg-slate-800/50 backdrop-blur-sm border-l border-white/10 flex flex-col items-center justify-center p-6 relative z-10 overflow-hidden group">
                        <!-- Cinta YMCKO Deslizándose -->
                        <div class="relative w-40 h-24 overflow-hidden shadow-2xl border border-slate-700 bg-slate-900 rounded-sm group">
                            <!-- Banda de gradiente infinito YMCKO -->
                            <div class="absolute top-0 left-0 w-[200%] h-full animate-[slide_4s_linear_infinite] opacity-90 group-hover:opacity-100 bg-[linear-gradient(to_right,#fde047_0%,#ec4899_10%,#06b6d4_20%,#000000_30%,#cbd5e1_40%,#fde047_50%,#ec4899_60%,#06b6d4_70%,#000000_80%,#cbd5e1_90%,#fde047_100%)]"></div>
                            
                            <!-- Ejes del Ribbon -->
                            <div class="absolute -left-3 top-[-10%] bottom-[-10%] w-6 bg-slate-400/90 rounded-full shadow-lg border-2 border-slate-300 animate-pulse"></div>
                            <div class="absolute -right-3 top-[-10%] bottom-[-10%] w-6 bg-slate-400/90 rounded-full shadow-lg border-2 border-slate-300 animate-pulse" style="animation-delay: 1s;"></div>
                        </div>
                        <style>
                            @keyframes slide {
                                0% { transform: translateX(0); }
                                100% { transform: translateX(-50%); }
                            }
                            @keyframes spin-slow {
                                0% { transform: rotate(0deg); }
                                100% { transform: rotate(360deg); }
                            }
                            .animate-spin-slow { animation: spin-slow 8s linear infinite; }
                        </style>
                    </div>
                </div>

                <!-- Grid Único de Características (Impresión + Gestión) -->
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 xl:gap-6 auto-rows-min">
                    <!-- Card: Tarjetas PVC -->
                    <div class="bg-white rounded-3xl p-8 border border-gray-100 shadow-sm hover:shadow-md transition-all group overflow-hidden relative lg:col-span-1">
                        <div class="absolute -right-6 -bottom-6 opacity-[0.03] text-corporate-red transform group-hover:scale-110 transition-transform duration-500 pointer-events-none">
                            <svg xmlns="http://www.w3.org/2000/svg" width="160" height="160" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
                        </div>
                        <div class="relative z-10 h-full flex flex-col justify-start">
                            <h3 class="font-headings font-bold text-xl text-deep-charcoal mb-3">Tarjetas y Composites</h3>
                            <p class="font-sans text-sm text-medium-gray leading-relaxed">
                                Desde tarjetas PVC estándar CR80 de 30 milésimas, hasta tarjetas compuestas PET altamente resistentes al calor de laminación.
                            </p>
                        </div>
                    </div>
                    
                    <!-- Card: Chips -->
                    <div class="bg-white rounded-3xl p-8 border border-gray-100 shadow-sm hover:shadow-md transition-all group overflow-hidden relative lg:col-span-1">
                        <div class="absolute -right-6 -bottom-6 opacity-[0.03] text-corporate-red transform group-hover:scale-110 transition-transform duration-500 pointer-events-none">
                            <svg xmlns="http://www.w3.org/2000/svg" width="160" height="160" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 22h14a2 2 0 0 0 2-2V7l-5-5H6a2 2 0 0 0-2 2v4"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M3 15h6"/><path d="M3 18h6"/></svg>
                        </div>
                        <div class="relative z-10 h-full flex flex-col justify-start">
                            <h3 class="font-headings font-bold text-xl text-deep-charcoal mb-3">Tarjetas para Codificación</h3>
                            <p class="font-sans text-sm text-medium-gray leading-relaxed">
                                Superficies impecables prefabricadas con chips de proximidad (Mifare, DESFire, HID) o banda magnética (HiCo/LoCo).
                            </p>
                        </div>
