---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
    title="Soporte y Preguntas Frecuentes FAQ | TOTALLCARD"
    description="Encuentra respuestas claras y rápidas sobre nuestras opciones de impresión de credenciales, accesorios, métodos de envío y calidad de cintas."
    keywords="soporte totallcard, envíos credenciales, faq totallcard, accesorios gafetes, tipos de cintas para imprimir, durabilidad tarjetas pvc"
>
    <Header submenu="empresa" active="PREGUNTAS FRECUENTES" />

    <!-- Hero Section Minimalista (Basado en Quiénes Somos) -->
    <section class="relative pt-8 pb-8 md:pt-48 md:pb-12 bg-white overflow-hidden">
        <div class="max-w-[1400px] mx-auto px-6 relative z-10">
            
            <div class="flex flex-col lg:flex-row lg:justify-between lg:items-start gap-8 lg:gap-16 mb-8 pt-6">
                <!-- Letras Gigantes (Izquierda) -->
                <h1 class="font-headings font-black text-[5.5rem] sm:text-[8rem] md:text-[11rem] lg:text-[13rem] text-black leading-[0.75] tracking-tighter uppercase shrink-0">
                    SOPORTE<br/>
                    <span class="text-corporate-red">& FAQ.</span>
                </h1>

                <!-- Eslogan (Derecha Gigante) -->
                <div class="lg:w-full lg:mt-4 flex lg:justify-end items-center">
                    <p class="font-headings text-black font-black text-4xl sm:text-6xl lg:text-[4.5rem] xl:text-[5.5rem] tracking-tighter uppercase leading-[0.85] lg:text-right border-l-8 lg:border-l-0 lg:border-r-[16px] border-corporate-red pl-6 lg:pl-0 lg:pr-8">
                        RESPUESTAS<br/>CLARAS.<br/>
                        <span class="text-corporate-red">SOLUCIONES<br/>RÁPIDAS.</span>
                    </p>
                </div>
            </div>

            <!-- Contenido Inferior -->
            <div class="mt-8">
                <!-- Texto descriptivo -->
                <div class="max-w-3xl">
                    <p class="font-headings font-bold text-xl md:text-3xl text-black leading-snug mb-6 border-l-8 border-corporate-red pl-6">
                        TODO LO QUE NECESITAS SABER.
                    </p>
                    <p class="font-sans text-black/70 text-lg md:text-xl mb-4 pl-8">
                        Resolvemos tus dudas sobre nuestros servicios, productos y entregas. Si no encuentras tu respuesta aquí, nuestro equipo técnico está listo para ayudarte.
                    </p>
                </div>
            </div>
            
        </div>
    </section>

    <!-- FAQ / Preguntas Frecuentes - Categoría: Envíos e Impresoras -->
    <section class="py-10 md:py-16 bg-slate-50 px-6 border-t border-b border-light-gray/40">
        <div class="max-w-[800px] mx-auto">
            <div class="mb-12 text-center md:text-left">
                <div class="flex items-center justify-center md:justify-start gap-3 mb-3">
                    <div class="w-12 h-[2px] bg-corporate-red"></div>
                    <span class="font-sans font-bold text-xs tracking-widest text-corporate-red uppercase">Información General</span>
                </div>
                <h2 class="font-headings font-bold text-3xl md:text-4xl text-deep-charcoal mb-4">Envíos y Equipos</h2>
            </div>
            
            <div class="space-y-4 max-w-[800px] mx-auto w-full">
                <!-- FAQ 1 -->
                <div class="faq-card group bg-white border border-slate-200 rounded-xl overflow-hidden cursor-pointer transition-all duration-500 relative z-10 hover:shadow-md [&.is-open]:shadow-xl [&.is-open]:scale-[1.02] [&.is-open]:border-corporate-red">
                    <div class="absolute inset-0 bg-corporate-red transform -translate-y-full transition-transform duration-500 ease-in-out z-0 group-[.is-open]:translate-y-0 pointer-events-none"></div>

                    <div class="p-6 px-7 relative z-10 flex justify-between items-center transition-colors duration-500">
                        <h3 class="font-headings font-bold text-deep-charcoal transition-colors duration-500 group-[.is-open]:text-white">
                            ¿Hacen envíos a toda la república?
                        </h3>
                        <div class="w-8 h-8 rounded-full bg-slate-100 flex items-center justify-center transition-all duration-500 shrink-0 ml-4 text-corporate-red group-[.is-open]:bg-white/20 group-[.is-open]:text-white">
                            <svg class="transition-transform duration-500 group-[.is-open]:rotate-180" fill="none" height="20" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="20"><polyline points="6 9 12 15 18 9"/></svg>
                        </div>
                    </div>

                    <div class="relative z-10 grid grid-rows-[0fr] transition-all duration-500 ease-in-out group-[.is-open]:grid-rows-[1fr]">
                        <div class="overflow-hidden">
                            <div class="px-7 pb-6 text-sm text-slate-500 leading-relaxed transition-colors duration-500 group-[.is-open]:text-white/90">
                                Sí, realizamos envíos de impresoras, consumibles y credenciales por volumen a cualquier estado del país mediante paquetería segura y asegurada.
                            </div>
                        </div>
                    </div>
                </div>

                <!-- FAQ 2 -->
                <div class="faq-card group bg-white border border-slate-200 rounded-xl overflow-hidden cursor-pointer transition-all duration-500 relative z-10 hover:shadow-md [&.is-open]:shadow-xl [&.is-open]:scale-[1.02] [&.is-open]:border-corporate-red">
                    <div class="absolute inset-0 bg-corporate-red transform -translate-y-full transition-transform duration-500 ease-in-out z-0 group-[.is-open]:translate-y-0 pointer-events-none"></div>

                    <div class="p-6 px-7 relative z-10 flex justify-between items-center transition-colors duration-500">
                        <h3 class="font-headings font-bold text-deep-charcoal transition-colors duration-500 group-[.is-open]:text-white">
                            ¿Venden consumibles originales?
                        </h3>
                        <div class="w-8 h-8 rounded-full bg-slate-100 flex items-center justify-center transition-all duration-500 shrink-0 ml-4 text-corporate-red group-[.is-open]:bg-white/20 group-[.is-open]:text-white">
                            <svg class="transition-transform duration-500 group-[.is-open]:rotate-180" fill="none" height="20" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="20"><polyline points="6 9 12 15 18 9"/></svg>
                        </div>
                    </div>

                    <div class="relative z-10 grid grid-rows-[0fr] transition-all duration-500 ease-in-out group-[.is-open]:grid-rows-[1fr]">
                        <div class="overflow-hidden">
                            <div class="px-7 pb-6 text-sm text-slate-500 leading-relaxed transition-colors duration-500 group-[.is-open]:text-white/90">
                                Por supuesto. Solo comercializamos cintas (ribbons), tarjetas de PVC y kits de limpieza 100% originales para que obtengas los mejores resultados de impresión y cuides tus equipos.
                            </div>
                        </div>
                    </div>
                </div>

                <!-- FAQ 3 -->
                <div class="faq-card group bg-white border border-slate-200 rounded-xl overflow-hidden cursor-pointer transition-all duration-500 relative z-10 hover:shadow-md [&.is-open]:shadow-xl [&.is-open]:scale-[1.02] [&.is-open]:border-corporate-red">
                    <div class="absolute inset-0 bg-corporate-red transform -translate-y-full transition-transform duration-500 ease-in-out z-0 group-[.is-open]:translate-y-0 pointer-events-none"></div>

                    <div class="p-6 px-7 relative z-10 flex justify-between items-center transition-colors duration-500">
                        <h3 class="font-headings font-bold text-deep-charcoal transition-colors duration-500 group-[.is-open]:text-white">
                            ¿Cómo puedo solicitar una cotización?
                        </h3>
                        <div class="w-8 h-8 rounded-full bg-slate-100 flex items-center justify-center transition-all duration-500 shrink-0 ml-4 text-corporate-red group-[.is-open]:bg-white/20 group-[.is-open]:text-white">
                            <svg class="transition-transform duration-500 group-[.is-open]:rotate-180" fill="none" height="20" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="20"><polyline points="6 9 12 15 18 9"/></svg>
                        </div>
                    </div>

                    <div class="relative z-10 grid grid-rows-[0fr] transition-all duration-500 ease-in-out group-[.is-open]:grid-rows-[1fr]">
                        <div class="overflow-hidden">
                            <div class="px-7 pb-6 text-sm text-slate-500 leading-relaxed transition-colors duration-500 group-[.is-open]:text-white/90">
                                Puedes contactarnos a través del formulario en nuestra página web, enviarnos un mensaje por WhatsApp o comunicarte directamente a nuestras líneas telefónicas. Nuestro equipo de asesores preparará una cotización ajustada a tus necesidades y volumen.
                            </div>
                        </div>
                    </div>
                </div>

                <!-- FAQ 4 -->
                <div class="faq-card group bg-white border border-slate-200 rounded-xl overflow-hidden cursor-pointer transition-all duration-500 relative z-10 hover:shadow-md [&.is-open]:shadow-xl [&.is-open]:scale-[1.02] [&.is-open]:border-corporate-red">
                    <div class="absolute inset-0 bg-corporate-red transform -translate-y-full transition-transform duration-500 ease-in-out z-0 group-[.is-open]:translate-y-0 pointer-events-none"></div>

                    <div class="p-6 px-7 relative z-10 flex justify-between items-center transition-colors duration-500">
                        <h3 class="font-headings font-bold text-deep-charcoal transition-colors duration-500 group-[.is-open]:text-white">
                            ¿Brindan asesoría para la elección de equipo?
                        </h3>
                        <div class="w-8 h-8 rounded-full bg-slate-100 flex items-center justify-center transition-all duration-500 shrink-0 ml-4 text-corporate-red group-[.is-open]:bg-white/20 group-[.is-open]:text-white">
                            <svg class="transition-transform duration-500 group-[.is-open]:rotate-180" fill="none" height="20" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="20"><polyline points="6 9 12 15 18 9"/></svg>
                        </div>
                    </div>

                    <div class="relative z-10 grid grid-rows-[0fr] transition-all duration-500 ease-in-out group-[.is-open]:grid-rows-[1fr]">
                        <div class="overflow-hidden">
                            <div class="px-7 pb-6 text-sm text-slate-500 leading-relaxed transition-colors duration-500 group-[.is-open]:text-white/90">
                                Sí, al comunicarte con nosotros, podemos guiarte para elegir la impresora que mejor se adapte a tu proyecto, considerando cantidad de impresiones, tecnologías de seguridad que requieras e insumos.
                            </div>
                        </div>
                    </div>
                </div>

                <!-- FAQ 5 -->
                <div class="faq-card group bg-white border border-slate-200 rounded-xl overflow-hidden cursor-pointer transition-all duration-500 relative z-10 hover:shadow-md [&.is-open]:shadow-xl [&.is-open]:scale-[1.02] [&.is-open]:border-corporate-red">
                    <div class="absolute inset-0 bg-corporate-red transform -translate-y-full transition-transform duration-500 ease-in-out z-0 group-[.is-open]:translate-y-0 pointer-events-none"></div>

                    <div class="p-6 px-7 relative z-10 flex justify-between items-center transition-colors duration-500">
                        <h3 class="font-headings font-bold text-deep-charcoal transition-colors duration-500 group-[.is-open]:text-white">
                            ¿Qué tipo de cintas (ribbons) suministran?
                        </h3>
                        <div class="w-8 h-8 rounded-full bg-slate-100 flex items-center justify-center transition-all duration-500 shrink-0 ml-4 text-corporate-red group-[.is-open]:bg-white/20 group-[.is-open]:text-white">
                            <svg class="transition-transform duration-500 group-[.is-open]:rotate-180" fill="none" height="20" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="20"><polyline points="6 9 12 15 18 9"/></svg>
                        </div>
                    </div>

                    <div class="relative z-10 grid grid-rows-[0fr] transition-all duration-500 ease-in-out group-[.is-open]:grid-rows-[1fr]">
                        <div class="overflow-hidden">
                            <div class="px-7 pb-6 text-sm text-slate-500 leading-relaxed transition-colors duration-500 group-[.is-open]:text-white/90">
                                Surtimos cintas originales tanto en monocromo (para datos e identificadores rápidos en un solo color) como a todo color con panel overlay (YMCKO) para impresión fotográfica completa.
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- FAQ / Preguntas Frecuentes - Categoría: Credenciales -->
    <section class="py-10 md:py-16 bg-white px-6">
        <div class="max-w-[800px] mx-auto">
            <div class="mb-12 text-center md:text-left">
                <div class="flex items-center justify-center md:justify-start gap-3 mb-3">
                    <div class="w-12 h-[2px] bg-corporate-red"></div>
                    <span class="font-sans font-bold text-xs tracking-widest text-corporate-red uppercase">Gafetes y Personalización</span>
                </div>
                <h2 class="font-headings font-bold text-3xl md:text-4xl text-deep-charcoal mb-4">Gafetes y Accesorios</h2>
            </div>
            
            <div class="space-y-4 max-w-[800px] mx-auto w-full">
                <!-- FAQ 4 -->
                <div class="faq-card group bg-white border border-slate-200 rounded-xl overflow-hidden cursor-pointer transition-all duration-500 relative z-10 hover:shadow-md [&.is-open]:shadow-xl [&.is-open]:scale-[1.02] [&.is-open]:border-corporate-red">
                    <div class="absolute inset-0 bg-corporate-red transform -translate-y-full transition-transform duration-500 ease-in-out z-0 group-[.is-open]:translate-y-0 pointer-events-none"></div>

                    <div class="p-6 px-7 relative z-10 flex justify-between items-center transition-colors duration-500">
                        <h3 class="font-headings font-bold text-deep-charcoal transition-colors duration-500 group-[.is-open]:text-white">
                            ¿Cuál es el pedido mínimo para gafetes empresariales?
                        </h3>
                        <div class="w-8 h-8 rounded-full bg-slate-100 flex items-center justify-center transition-all duration-500 shrink-0 ml-4 text-corporate-red group-[.is-open]:bg-white/20 group-[.is-open]:text-white">
                            <svg class="transition-transform duration-500 group-[.is-open]:rotate-180" fill="none" height="20" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="20"><polyline points="6 9 12 15 18 9"/></svg>
                        </div>
                    </div>

                    <div class="relative z-10 grid grid-rows-[0fr] transition-all duration-500 ease-in-out group-[.is-open]:grid-rows-[1fr]">
                        <div class="overflow-hidden">
                            <div class="px-7 pb-6 text-sm text-slate-500 leading-relaxed transition-colors duration-500 group-[.is-open]:text-white/90">
                                No contamos con un pedido mínimo estricto, sin embargo, ofrecemos precios preferenciales por volumen para corporativos. Podemos surtir desde una sola pieza hasta tirajes de miles de credenciales.
                            </div>
                        </div>
                    </div>
                </div>

                <!-- FAQ 5 -->
                <div class="faq-card group bg-white border border-slate-200 rounded-xl overflow-hidden cursor-pointer transition-all duration-500 relative z-10 hover:shadow-md [&.is-open]:shadow-xl [&.is-open]:scale-[1.02] [&.is-open]:border-corporate-red">
                    <div class="absolute inset-0 bg-corporate-red transform -translate-y-full transition-transform duration-500 ease-in-out z-0 group-[.is-open]:translate-y-0 pointer-events-none"></div>

                    <div class="p-6 px-7 relative z-10 flex justify-between items-center transition-colors duration-500">
                        <h3 class="font-headings font-bold text-deep-charcoal transition-colors duration-500 group-[.is-open]:text-white">
                            ¿Pueden integrar la tecnología de nuestro sistema de acceso actual?
                        </h3>
                        <div class="w-8 h-8 rounded-full bg-slate-100 flex items-center justify-center transition-all duration-500 shrink-0 ml-4 text-corporate-red group-[.is-open]:bg-white/20 group-[.is-open]:text-white">
                            <svg class="transition-transform duration-500 group-[.is-open]:rotate-180" fill="none" height="20" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="20"><polyline points="6 9 12 15 18 9"/></svg>
                        </div>
                    </div>

                    <div class="relative z-10 grid grid-rows-[0fr] transition-all duration-500 ease-in-out group-[.is-open]:grid-rows-[1fr]">
                        <div class="overflow-hidden">
                            <div class="px-7 pb-6 text-sm text-slate-500 leading-relaxed transition-colors duration-500 group-[.is-open]:text-white/90">
                                Sí, trabajamos con diversas tecnologías como chips RFID, NFC (Mifare), código de barras y banda magnética. Nuestros gafetes son completamente compatibles con la mayoría de los sistemas de checado y accesos del mercado.
                            </div>
                        </div>
                    </div>
                </div>

                <!-- FAQ 6 -->
                <div class="faq-card group bg-white border border-slate-200 rounded-xl overflow-hidden cursor-pointer transition-all duration-500 relative z-10 hover:shadow-md [&.is-open]:shadow-xl [&.is-open]:scale-[1.02] [&.is-open]:border-corporate-red">
                    <div class="absolute inset-0 bg-corporate-red transform -translate-y-full transition-transform duration-500 ease-in-out z-0 group-[.is-open]:translate-y-0 pointer-events-none"></div>

                    <div class="p-6 px-7 relative z-10 flex justify-between items-center transition-colors duration-500">
                        <h3 class="font-headings font-bold text-deep-charcoal transition-colors duration-500 group-[.is-open]:text-white">
                            ¿Ustedes realizan el diseño del gafete?
                        </h3>
                        <div class="w-8 h-8 rounded-full bg-slate-100 flex items-center justify-center transition-all duration-500 shrink-0 ml-4 text-corporate-red group-[.is-open]:bg-white/20 group-[.is-open]:text-white">
                            <svg class="transition-transform duration-500 group-[.is-open]:rotate-180" fill="none" height="20" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="20"><polyline points="6 9 12 15 18 9"/></svg>
                        </div>
                    </div>

                    <div class="relative z-10 grid grid-rows-[0fr] transition-all duration-500 ease-in-out group-[.is-open]:grid-rows-[1fr]">
                        <div class="overflow-hidden">
                            <div class="px-7 pb-6 text-sm text-slate-500 leading-relaxed transition-colors duration-500 group-[.is-open]:text-white/90">
                                Contamos con un equipo de diseño que puede crear y adaptar el formato respetando estrictamente tu manual de identidad, colores corporativos y logotipo; o bien, si ya tienes un diseño propio, podemos trabajar e imprimir directamente con él.
                            </div>
                        </div>
                    </div>
                </div>

                <!-- FAQ 7 -->
                <div class="faq-card group bg-white border border-slate-200 rounded-xl overflow-hidden cursor-pointer transition-all duration-500 relative z-10 hover:shadow-md [&.is-open]:shadow-xl [&.is-open]:scale-[1.02] [&.is-open]:border-corporate-red">
                    <div class="absolute inset-0 bg-corporate-red transform -translate-y-full transition-transform duration-500 ease-in-out z-0 group-[.is-open]:translate-y-0 pointer-events-none"></div>

                    <div class="p-6 px-7 relative z-10 flex justify-between items-center transition-colors duration-500">
                        <h3 class="font-headings font-bold text-deep-charcoal transition-colors duration-500 group-[.is-open]:text-white">
                            ¿Puedo imprimir yo mismo los gafetes?
                        </h3>
                        <div class="w-8 h-8 rounded-full bg-slate-100 flex items-center justify-center transition-all duration-500 shrink-0 ml-4 text-corporate-red group-[.is-open]:bg-white/20 group-[.is-open]:text-white">
                            <svg class="transition-transform duration-500 group-[.is-open]:rotate-180" fill="none" height="20" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="20"><polyline points="6 9 12 15 18 9"/></svg>
                        </div>
                    </div>

                    <div class="relative z-10 grid grid-rows-[0fr] transition-all duration-500 ease-in-out group-[.is-open]:grid-rows-[1fr]">
                        <div class="overflow-hidden">
                            <div class="px-7 pb-6 text-sm text-slate-500 leading-relaxed transition-colors duration-500 group-[.is-open]:text-white/90">
                                Sí, también proveemos impresoras PVC y tarjetas en blanco listas para que tú y tu equipo impriman gafetes al instante en sus propias instalaciones.
                            </div>
                        </div>
                    </div>
                </div>

                <!-- FAQ 8 -->
                <div class="faq-card group bg-white border border-slate-200 rounded-xl overflow-hidden cursor-pointer transition-all duration-500 relative z-10 hover:shadow-md [&.is-open]:shadow-xl [&.is-open]:scale-[1.02] [&.is-open]:border-corporate-red">
                    <div class="absolute inset-0 bg-corporate-red transform -translate-y-full transition-transform duration-500 ease-in-out z-0 group-[.is-open]:translate-y-0 pointer-events-none"></div>

                    <div class="p-6 px-7 relative z-10 flex justify-between items-center transition-colors duration-500">
                        <h3 class="font-headings font-bold text-deep-charcoal transition-colors duration-500 group-[.is-open]:text-white">
                            ¿Venden accesorios por separado sin necesidad de comprar credenciales?
                        </h3>
                        <div class="w-8 h-8 rounded-full bg-slate-100 flex items-center justify-center transition-all duration-500 shrink-0 ml-4 text-corporate-red group-[.is-open]:bg-white/20 group-[.is-open]:text-white">
                            <svg class="transition-transform duration-500 group-[.is-open]:rotate-180" fill="none" height="20" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="20"><polyline points="6 9 12 15 18 9"/></svg>
                        </div>
                    </div>

                    <div class="relative z-10 grid grid-rows-[0fr] transition-all duration-500 ease-in-out group-[.is-open]:grid-rows-[1fr]">
                        <div class="overflow-hidden">
                            <div class="px-7 pb-6 text-sm text-slate-500 leading-relaxed transition-colors duration-500 group-[.is-open]:text-white/90">
                                Claro que sí. Tenemos a la venta yoyos retráctiles (lisos o con gota de resina), lanyards y portagafetes rígidos o de vinil, listos para complementar cualquier tipo de tarjeta que ya tengas.
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Call To Action (Banner Final) -->
    <section class="py-12 md:py-16 bg-corporate-red px-6 relative overflow-hidden">
        <!-- SVG Decoración (Efecto Múltiples Ondas) -->
        <div class="absolute inset-0 mix-blend-overlay opacity-20 pointer-events-none">
            <svg viewBox="0 0 100 100" preserveAspectRatio="none" class="w-full h-full text-white" fill="currentColor">
                <path d="M0,0 C30,30 70,-10 100,50 L100,100 L0,100 Z" opacity="0.3"></path>
                <path d="M0,50 C40,-10 60,60 100,20 L100,100 L0,100 Z"></path>
            </svg>
        </div>

        <div class="max-w-[1280px] mx-auto relative z-10 flex flex-col md:flex-row items-center justify-between gap-8 text-center md:text-left">
            <div>
                <h2 class="font-headings font-bold text-3xl md:text-4xl text-white mb-3">¿Aún tienes dudas?</h2>
                <p class="font-sans text-white/80 text-sm md:text-base max-w-lg">Contacta con nuestro soporte técnico y resolveremos cualquier inquietud sobre especificaciones, envíos o precios.</p>
            </div>
            <div class="shrink-0">
                <a href="https://wa.me/525615429492" class="more-button alt-button inline-flex shadow-lg hover:shadow-xl transition-all">
                    <div class="docs py-4 px-8 border-none">
                        <span class="font-bold text-[14px] md:text-[15px] uppercase tracking-wider">Hablar con un asesor</span>
                    </div>
                    <div class="download border-none">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                    </div>
                </a>
            </div>
        </div>
    </section>

    <Footer />
</Layout>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        // Implementación de las Interactive Morphing Cards (FAQ)
        const faqCards = document.querySelectorAll('.faq-card');
        
        faqCards.forEach(card => {
            card.addEventListener('click', () => {
                // Cerrar las otras que estén abiertas (Acordeón)
                faqCards.forEach(otherCard => {
                    if (otherCard !== card && otherCard.classList.contains('is-open')) {
                        otherCard.classList.remove('is-open');
                    }
                });
                
                // Alternar el estado open de la tarjeta actual
                card.classList.toggle('is-open');
            });
        });
    });
</script>

