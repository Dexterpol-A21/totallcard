---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Lanyard from '../components/Lanyard.jsx';
import Footer from '../components/Footer.astro';
---

<Layout 
	title="Gafetes Empresariales y Corporativos de Alta Seguridad | TOTALLCARD" 
	description="Identificación profesional, segura y con estilo para los colaboradores de tu empresa. Refuerza la identidad corporativa con impresión en PVC de alta durabilidad y hologramas."
	keywords="gafetes empresariales, credenciales corporativas, identificaciones para empresas, gafetes de seguridad, impresión PVC corporativo"
>
	<div class="hidden lg:flex fixed inset-0 z-[100] pointer-events-none w-screen h-screen">
                <Lanyard client:only="react" position={[0, 0, 45]} gravity={[0, -40, 0]} />
        </div>
        <Header submenu="tarjetas" active="GAFETES EMPRESARIALES" />
	<section class="lg:min-h-[85vh] flex items-start lg:items-center pt-8 pb-8 lg:pt-40 md:pb-12 px-6 bg-white overflow-hidden relative">
		<div class="max-w-[1280px] mx-auto grid md:grid-cols-2 gap-8 items-center w-full">
			<div class="z-10">
				<p class="font-headings text-corporate-red font-bold text-xs md:text-sm tracking-widest uppercase mb-4">
					Identidad Corporativa Segura.
				</p>
				<h1 class="font-headings font-extrabold text-4xl md:text-5xl lg:text-6xl text-deep-charcoal leading-[1.1] mb-6">
					Gafetes Empresariales
				</h1>
				<p class="font-sans text-base md:text-lg text-medium-gray mb-6 max-w-xl">
					Identificación profesional, segura y con estilo para los colaboradores de tu empresa. Refuerza la identidad corporativa y asegura tus instalaciones.
				</p>
				
				<div class="flex flex-col sm:flex-row gap-6 mb-6 items-center">
					<a href="https://wa.me/525615429492" class="download-button inline-flex">
						<div class="docs py-3 px-6">
							<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21l1.65-3.8a9 9 0 1 1 3.4 2.9L3 21" /><path d="M9 10a.5.5 0 0 0 1 0V9a.5.5 0 0 0-1 0v1a5 5 0 0 0 5 5h1a.5.5 0 0 0 0-1h-1a.5.5 0 0 0 0 1" /></svg>
							<span class="font-bold text-[15px] tracking-wider uppercase">COTIZACIÓN POR WHATSAPP</span>
						</div>
						<div class="download">
							<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/></svg>
						</div>
					</a>
				</div>
                
                <div class="flex flex-wrap md:flex-nowrap justify-start gap-6 md:gap-8 pt-2">
                    <div class="flex flex-row items-center gap-4 w-full md:w-auto">
                        <div class="w-12 h-12 rounded bg-light-gray/40 flex items-center justify-center shrink-0">
                            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-corporate-red"><rect x="3" y="4" width="18" height="16" rx="2" ry="2"></rect><line x1="8" y1="2" x2="8" y2="6"></line><line x1="16" y1="2" x2="16" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                        </div>
                        <span class="font-headings font-bold text-[11px] md:text-xs uppercase tracking-widest text-deep-charcoal leading-snug">Impresión<br />HD</span>
                    </div>
                    <div class="flex flex-row items-center gap-4 w-full md:w-auto">
                        <div class="w-12 h-12 rounded bg-light-gray/40 flex items-center justify-center shrink-0">
                            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-corporate-red"><path d="M4 11a9 9 0 0 1 9 9"></path><path d="M4 4a16 16 0 0 1 16 16"></path><circle cx="5" cy="19" r="1"></circle></svg>
                        </div>
                        <span class="font-headings font-bold text-[11px] md:text-xs uppercase tracking-widest text-deep-charcoal leading-snug">Tecnología<br />RFID / NFC</span>
                    </div>
                    <div class="flex flex-row items-center gap-4 w-full md:w-auto">
                        <div class="w-12 h-12 rounded bg-light-gray/40 flex items-center justify-center shrink-0">
                            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-corporate-red"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
                        </div>
                        <span class="font-headings font-bold text-[11px] md:text-xs uppercase tracking-widest text-deep-charcoal leading-snug">Alta<br />Durabilidad</span>
                    </div>
                </div>
			</div>
			
			<div class="relative w-full h-[350px] md:h-[500px]">
                <div class="w-full h-[300px] md:h-full relative z-10 pointer-events-none select-none">
                    <picture class="contents">
    <source srcset="/images/empresarial.avif" type="image/avif" />
    <source srcset="/images/empresarial.webp" type="image/webp" />
    <img draggable="false" src="/images/empresarial.png" alt="Gafetes Empresariales" class="w-full h-full object-cover relative z-10 rounded-[2rem] shadow-2xl border-[8px] border-white pointer-events-none select-none" / loading="lazy" decoding="async">
</picture>
                </div>
			</div>
		</div>
	</section>

        <!-- Aplicaciones / A quién va dirigido -->
        <section class="py-10 md:py-12 px-6 bg-slate-50 border-b border-light-gray/40">
            <div class="max-w-[1280px] mx-auto">
                <div class="text-center max-w-2xl mx-auto mb-12">
                    <div class="flex items-center justify-center gap-3 mb-3">
                        <div class="w-12 h-[2px] bg-corporate-red"></div>
                        <span class="font-sans font-bold text-xs tracking-widest text-corporate-red uppercase">Aplicaciones</span>
                    </div>
                    <h2 class="font-headings font-bold text-3xl md:text-4xl text-deep-charcoal mb-4">¿Para quiénes son nuestros Gafetes?</h2>
                    <p class="font-sans text-medium-gray">Soluciones diseñadas específicamente para fortalecer la identidad corporativa y los protocolos de seguridad en tu organización.</p>
                </div>
                
                <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
                    <!-- Sector 1 -->
                    <div class="bg-white rounded-2xl p-8 hover:-translate-y-1 transition-transform border border-slate-100 flex flex-col items-center text-center shadow-sm">
                        <div class="w-16 h-16 bg-slate-50 rounded-full flex items-center justify-center mb-4 text-corporate-red">
                            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="2" width="16" height="20" rx="2" ry="2"/><path d="M9 22v-4h6v4"/><path d="M8 6h.01"/><path d="M16 6h.01"/><path d="M12 6h.01"/><path d="M12 10h.01"/><path d="M12 14h.01"/><path d="M16 10h.01"/><path d="M16 14h.01"/><path d="M8 10h.01"/><path d="M8 14h.01"/></svg>
                        </div>
                        <h4 class="font-headings font-bold text-deep-charcoal mb-2">Corporativos</h4>
                        <p class="font-sans text-xs text-slate-500">Manejo de identidad visual para empresas de todos tamaños.</p>
                    </div>
                    <!-- Sector 2 -->
                    <div class="bg-white rounded-2xl p-8 hover:-translate-y-1 transition-transform border border-slate-100 flex flex-col items-center text-center shadow-sm">
                        <div class="w-16 h-16 bg-slate-50 rounded-full flex items-center justify-center mb-4 text-corporate-red">
                            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
                        </div>
                        <h4 class="font-headings font-bold text-deep-charcoal mb-2">Plantillas de Oficina</h4>
                        <p class="font-sans text-xs text-slate-500">Control de acceso y presencia para recursos humanos y staff interno.</p>
                    </div>
                    <!-- Sector 3 -->
                    <div class="bg-white rounded-2xl p-8 hover:-translate-y-1 transition-transform border border-slate-100 flex flex-col items-center text-center shadow-sm">
                        <div class="w-16 h-16 bg-slate-50 rounded-full flex items-center justify-center mb-4 text-corporate-red">
                            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m2 7 4.41-4.41A2 2 0 0 1 7.83 2h8.34a2 2 0 0 1 1.42.59L22 7"/><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/><path d="M15 22v-4a2 2 0 0 0-2-2h-2a2 2 0 0 0-2 2v4"/><path d="M2 7h20"/><path d="M22 7v3a2 2 0 0 1-2 2v0a2.7 2.7 0 0 1-1.59-.63.7.7 0 0 0-.82 0A2.7 2.7 0 0 1 16 12a2.7 2.7 0 0 1-1.59-.63.7.7 0 0 0-.82 0A2.7 2.7 0 0 1 12 12a2.7 2.7 0 0 1-1.59-.63.7.7 0 0 0-.82 0A2.7 2.7 0 0 1 8 12a2.7 2.7 0 0 1-1.59-.63.7.7 0 0 0-.82 0A2.7 2.7 0 0 1 4 12v0a2 2 0 0 1-2-2V7"/></svg>
                        </div>
                        <h4 class="font-headings font-bold text-deep-charcoal mb-2">Retail y Franquicias</h4>
                        <p class="font-sans text-xs text-slate-500">Identificación clara del personal en sucursales y piso de ventas.</p>
                    </div>
                    <!-- Sector 4 -->
                    <div class="bg-white rounded-2xl p-8 hover:-translate-y-1 transition-transform border border-slate-100 flex flex-col items-center text-center shadow-sm">
                        <div class="w-16 h-16 bg-slate-50 rounded-full flex items-center justify-center mb-4 text-corporate-red">
                            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M10 17h4V5H2v12h3"/><path d="M20 17h2v-3.34a4 4 0 0 0-1.17-2.83L19 9h-5"/><path d="M14 17h1"/><circle cx="7.5" cy="17.5" r="2.5"/><circle cx="17.5" cy="17.5" r="2.5"/></svg>
                        </div>
                        <h4 class="font-headings font-bold text-deep-charcoal mb-2">Industria y Logística</h4>
                        <p class="font-sans text-xs text-slate-500">Gafetes de alta resistencia para ambientes de almacén y planta.</p>
                    </div>
                </div>
            </div>
        </section>

	<!-- Diagrama / Infografía de Credencial -->
        <section class="py-10 md:py-12 px-6 bg-white relative overflow-hidden border-b border-light-gray/40">
        <div class="max-w-[1280px] mx-auto text-center mb-16 relative z-10">
            <h2 class="font-headings font-bold text-3xl md:text-4xl text-deep-charcoal mb-4">Anatomía de un Gafete Corporativo</h2>
            <p class="font-sans text-medium-gray max-w-2xl mx-auto">Proyección corporativa 100% personalizable a tus necesidades y diseño. Conoce las características físicas que validan a tu equipo.</p>
        </div>

        <div class="max-w-[1000px] mx-auto relative flex flex-col items-center justify-center min-h-[500px] lg:min-h-[550px] z-10">
            
            <!-- TARJETA CENTRAL -->
            <div class="pvc-card relative flex flex-col w-full aspect-[54/86] max-w-[280px] mx-auto bg-white rounded-[14px] overflow-hidden shadow-2xl border border-gray-300 z-30 transform hover:scale-105 transition-transform duration-500">
                <!-- Perforación (Punch) -->
                <div class="absolute top-3 left-1/2 -translate-x-1/2 w-14 h-2.5 bg-gray-100 rounded-full shadow-[inset_0_2px_4px_rgba(0,0,0,0.2)] border border-gray-300 z-30 punch-point"></div>
                
                <!-- Header Corporativo -->
                <div class="w-full bg-white border-b border-gray-200 pt-7 pb-2 px-4 flex justify-between items-center z-20 header-point">
                    <div class="flex items-center">
                        <picture class="contents">
    <source srcset="/images/logoIconNoF.avif" type="image/avif" />
    <source srcset="/images/logoIconNoF.webp" type="image/webp" />
    <img src="/images/logoIconNoF.png" alt="Icono" class="h-4 object-contain -mt-0.5 -mr-2.5 relative z-30" / loading="lazy" decoding="async">
</picture>
                        <div class="flex flex-col items-center justify-center -space-y-2">
                            <img src="/icons/flechaLogoRojo.svg" alt="" class="h-6 relative z-20 w-[90px]" / loading="lazy" decoding="async">
                            <picture class="contents">
    <source srcset="/images/logoTextoNoF.avif" type="image/avif" />
    <source srcset="/images/logoTextoNoF.webp" type="image/webp" />
    <img src="/images/logoTextoNoF.PNG" alt="TotallCard" class="h-5 object-contain relative z-10" / loading="lazy" decoding="async">
</picture>
                            <img src="/icons/flechaLogoRojo.svg" alt="" class="h-6 rotate-180 relative z-20 w-[90px]" / loading="lazy" decoding="async">
                        </div>
                    </div>
                    <div class="text-deep-charcoal text-[7.5px] uppercase font-bold tracking-widest text-right leading-[1.2]">Acceso<br>Autorizado</div>
                </div>

                <!-- Contenido y Foto -->
                <div class="flex-1 flex flex-col items-center p-5 pt-6 relative overflow-hidden">
                    <div class="absolute -right-12 top-1/4 opacity-[0.06] -rotate-12 z-0 pointer-events-none">
                        <img src="/icons/flechaLogoRojo.svg" alt="" class="w-48" / loading="lazy" decoding="async">
                    </div>

                    <!-- Foto del Empleado -->
                    <div class="w-[100px] h-[100px] rounded-full overflow-hidden border-[3px] border-corporate-red shadow-md bg-gray-50 mb-3 z-10 flex items-center justify-center relative photo-point">
                        <svg xmlns="http://www.w3.org/2000/svg" width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-gray-300"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                    </div>
                    
                    <!-- Datos -->
                    <div class="text-point w-full text-center relative z-10">
                        <h3 class="font-headings font-bold text-lg text-deep-charcoal leading-tight text-center">Nombre del Empleado</h3>
                        <p class="font-sans text-[11px] text-corporate-blue font-semibold uppercase tracking-wider mb-1 mt-1">Cargo / Departamento</p>
                        <p class="font-sans text-[12px] text-medium-gray text-center leading-snug w-full mt-2">Personalizado acorde a tu manual de identidad corporativa.</p>
                    </div>
                    
                    <!-- Código de Barras -->
                    <div class="mt-auto w-full barcode-point relative z-10">
                        <div class="w-full flex flex-col items-center justify-center border-t border-gray-100 pt-3">
                            <div class="flex justify-center gap-[2px] h-8 w-[80%] opacity-80">
                                <div class="w-1 h-full bg-black"></div><div class="w-0.5 h-full bg-black"></div><div class="w-1.5 h-full bg-black"></div><div class="w-0.5 h-full bg-black"></div><div class="w-1 h-full bg-black"></div><div class="w-2 h-full bg-black"></div><div class="w-[1px] h-full bg-black"></div><div class="w-1.5 h-full bg-black"></div><div class="w-0.5 h-full bg-black"></div><div class="w-1 h-full bg-black"></div><div class="w-0.5 h-full bg-black"></div><div class="w-2 h-full bg-black"></div><div class="w-[1px] h-full bg-black"></div><div class="w-1 h-full bg-black"></div><div class="w-1.5 h-full bg-black"></div>
                            </div>
                            <span class="text-[9px] tracking-[0.25em] font-mono text-gray-500 mt-1">84902175932</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ANOTACIONES Y LÍNEAS (Desktop/LG) -->
            <div class="hidden lg:block absolute inset-0 pointer-events-none z-20">
                
                <!-- Apunte 1: Perforación (Arriba Izquierda) -->
                <div class="absolute top-[5%] left-[-15%] text-right w-[320px]">
                    <div class="bg-white p-4 rounded-xl shadow-lg border border-slate-100 inline-block pointer-events-auto hover:-translate-y-1 transition-transform">
                        <div class="flex items-center gap-2 mb-1 justify-end">
                            <h4 class="font-headings font-bold text-deep-charcoal">Perforación Estándar</h4>
                            <div class="w-2 h-2 rounded-full bg-corporate-red"></div>
                        </div>
                        <p class="font-sans text-xs text-slate-500">Slot compatible con broches, yoyos y lanyards de cualquier tipo.</p>
                    </div>
                    <!-- Línea SVG -->
                    <svg class="absolute top-1/2 left-[100%] ml-2 w-[160px] h-[60px] overflow-visible" style="transform: translateY(-50%)">
                        <path d="M0,30 Q80,30 160,80" fill="none" stroke="#cbd5e1" stroke-width="2" stroke-dasharray="4,4" />
                        <circle cx="160" cy="80" r="4" fill="#e1061a" />
                    </svg>
                </div>

                <!-- Apunte 2: Diseño Institucional (Centro Derecha) -->
                <div class="absolute top-[25%] right-[-15%] text-left w-[320px]">
                    <div class="bg-white p-4 rounded-xl shadow-lg border border-slate-100 inline-block pointer-events-auto hover:-translate-y-1 transition-transform">
                        <div class="flex items-center gap-2 mb-1 justify-start">
                            <div class="w-2 h-2 rounded-full bg-corporate-red"></div>
                            <h4 class="font-headings font-bold text-deep-charcoal">Diseño Corporativo</h4>
                        </div>
                        <p class="font-sans text-xs text-slate-500">Integración de logotipos y colores exactos de manual de marca.</p>
                    </div>
                    <!-- Línea SVG -->
                    <svg class="absolute top-1/2 right-[100%] mr-2 w-[160px] h-[40px] overflow-visible" style="transform: translateY(-50%)">
                        <path d="M160,20 Q80,20 0,90" fill="none" stroke="#cbd5e1" stroke-width="2" stroke-dasharray="4,4" />
                        <circle cx="0" cy="90" r="4" fill="#e1061a" />
                    </svg>
                </div>

                <!-- Apunte 3: Foto (Centro Izquierda) -->
                <div class="absolute top-[45%] left-[-15%] text-right w-[320px]">
                    <div class="bg-white p-4 rounded-xl shadow-lg border border-slate-100 inline-block pointer-events-auto hover:-translate-y-1 transition-transform">
                        <div class="flex items-center gap-2 mb-1 justify-end">
                            <h4 class="font-headings font-bold text-deep-charcoal">Resolución Fotográfica</h4>
                            <div class="w-2 h-2 rounded-full bg-corporate-red"></div>
                        </div>
                        <p class="font-sans text-xs text-slate-500">Tecnología re-transferencia, resalta rostros sin perder detalle.</p>
                    </div>
                    <!-- Línea SVG -->
                    <svg class="absolute top-1/2 left-[100%] ml-2 w-[180px] h-[20px] overflow-visible" style="transform: translateY(-50%)">
                        <path d="M0,10 L160,10" fill="none" stroke="#cbd5e1" stroke-width="2" stroke-dasharray="4,4" />
                        <circle cx="160" cy="10" r="4" fill="#e1061a" />
                    </svg>
                </div>

                <!-- Apunte 4: Seguridad (Abajo Derecha) -->
                <div class="absolute top-[75%] right-[-15%] text-left w-[320px]">
                    <div class="bg-white p-4 rounded-xl shadow-lg border border-slate-100 inline-block pointer-events-auto hover:-translate-y-1 transition-transform">
                        <div class="flex items-center gap-2 mb-1 justify-start">
                            <div class="w-2 h-2 rounded-full bg-corporate-red"></div>
                            <h4 class="font-headings font-bold text-deep-charcoal">Tecnología Opcional</h4>
                        </div>
                        <p class="font-sans text-xs text-slate-500">Códigos 1D/2D, QR o embutido de chips rfid (MiFare, Proximidad).</p>
                    </div>
                    <!-- Línea SVG -->
                    <svg class="absolute top-1/2 right-[100%] mr-2 w-[180px] h-[60px] overflow-visible" style="transform: translateY(-50%)">
                        <path d="M180,30 Q90,30 20,-10" fill="none" stroke="#cbd5e1" stroke-width="2" stroke-dasharray="4,4" />
                        <circle cx="20" cy="-10" r="4" fill="#e1061a" />
                    </svg>
                </div>

            </div>
            
            <!-- ANOTACIONES MOBILE (Lista debajo de la tarjeta en móvil) -->
            <div class="lg:hidden w-full mt-10 grid gap-4 grid-cols-1 sm:grid-cols-2 text-left relative z-20">
                <div class="bg-white p-4 rounded-xl shadow-sm border border-slate-100">
                    <h4 class="font-headings font-bold text-deep-charcoal mb-1 flex items-center gap-2"><span class="text-corporate-red">&bull;</span> Perforación Estándar</h4>
                    <p class="font-sans text-xs text-slate-500">Slot compatible con todos nuestros portagafetes y lanyards.</p>
                </div>
                <div class="bg-white p-4 rounded-xl shadow-sm border border-slate-100">
                    <h4 class="font-headings font-bold text-deep-charcoal mb-1 flex items-center gap-2"><span class="text-corporate-red">&bull;</span> Diseño Corporativo</h4>
                    <p class="font-sans text-xs text-slate-500">Integración de logotipos y manual de marca exactos.</p>
                </div>
                <div class="bg-white p-4 rounded-xl shadow-sm border border-slate-100">
                    <h4 class="font-headings font-bold text-deep-charcoal mb-1 flex items-center gap-2"><span class="text-corporate-red">&bull;</span> Resolución Fotográfica</h4>
                    <p class="font-sans text-xs text-slate-500">Impresión brillante que resalta rostros sin distorsión.</p>
                </div>
                <div class="bg-white p-4 rounded-xl shadow-sm border border-slate-100">
                    <h4 class="font-headings font-bold text-deep-charcoal mb-1 flex items-center gap-2"><span class="text-corporate-red">&bull;</span> Tecnología</h4>
                    <p class="font-sans text-xs text-slate-500">Códigos de barras, QR o chips RFID de proximidad.</p>
                </div>
            </div>

        </div>
	</section>

        <!-- Nuestro Proceso de Compra -->
        <section class="py-10 md:py-12 bg-white px-6">
                <div class="max-w-[1280px] mx-auto">
                        <div class="mb-12">
                                <div class="flex items-center gap-3 mb-3">
                                        <div class="w-12 h-[2px] bg-corporate-red"></div>
