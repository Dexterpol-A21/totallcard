        document.addEventListener('DOMContentLoaded', () => {
            // Helper function to setup gallery dots
            function setupGalleryConfig(containerId, dotsContainerId) {
                const container = document.getElementById(containerId);
                const dotsContainer = document.getElementById(dotsContainerId);
                
                if (!container || !dotsContainer) return;
                
                const cards = container.children;
                if (cards.length === 0) return;

                // Create dots
                dotsContainer.innerHTML = '';
                for (let i = 0; i < cards.length; i++) {
                    const dot = document.createElement('div');
                    dot.className = `w-2 h-2 rounded-full transition-all duration-300 ${i === 0 ? 'bg-corporate-red w-4' : 'bg-gray-300'}`;
                    dotsContainer.appendChild(dot);
                }

                const dots = dotsContainer.children;

                // Update dots on scroll
                container.addEventListener('scroll', () => {
                    const scrollLeft = container.scrollLeft;
                    const cardWidth = cards[0].offsetWidth + parseInt(window.getComputedStyle(cards[0]).marginRight || 0); // Include gap
                    const activeIndex = Math.round(scrollLeft / cardWidth);

                    for (let i = 0; i < dots.length; i++) {
                        if (i === activeIndex) {
                            dots[i].className = 'w-4 h-2 rounded-full transition-all duration-300 bg-corporate-red';
                        } else {
                            dots[i].className = 'w-2 h-2 rounded-full transition-all duration-300 bg-gray-300';
                        }
                    }
                });
            }

            // Init mobile galleries
            setupGalleryConfig('acabados-container', 'dots-acabados');
        });
    </script>
        <Footer />

</Layout>

