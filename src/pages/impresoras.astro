---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Lanyard from '../components/Lanyard.jsx';
import Footer from '../components/Footer.astro';
---

<Layout 
        title="Venta de Impresoras de Tarjetas y Gafetes | TOTALLCARD" 
        description="Equipos profesionales para impresión de credenciales en tus propias instalaciones. Las mejores impresoras, ribbons y suministros."
        keywords="impresoras de tarjetas pvc, impresoras de gafetes, venta de impresoras para tarjetas, ribbons y consumibles, tarjetas en blanco"
>
        <!-- Lanyard global CTA -->
        <div class="hidden lg:flex fixed inset-0 z-[100] pointer-events-none w-screen h-screen">
            <Lanyard client:only="react" position={[0, 0, 45]} gravity={[0, -40, 0]} />
        </div>
        <Header submenu="equipos" active="IMPRESORAS" />
	<!-- Hero Section: Centro de Impresión -->
	<section class="lg:min-h-[85vh] flex items-start lg:items-center pt-8 pb-8 lg:pt-40 md:pb-12 px-6 bg-slate-50 relative overflow-hidden">
		<div class="max-w-[1280px] mx-auto grid md:grid-cols-2 gap-8 items-center w-full relative z-10">
			<div>
				<p class="font-headings text-corporate-red font-bold text-xs md:text-sm tracking-widest uppercase mb-4 flex items-center gap-2">
                    <span class="w-8 h-[2px] bg-corporate-red"></span>
					Equipos Profesionales
				</p>
				<h1 class="font-headings font-extrabold text-4xl md:text-5xl lg:text-6xl text-deep-charcoal leading-[1.1] mb-6">
					Impresoras de Tarjetas y Gafetes
				</h1>
				<p class="font-sans text-base md:text-lg text-medium-gray mb-6 max-w-xl leading-relaxed">
					Equipa a tu empresa con la mejor tecnología en expedición de gafetes. Distribuidores directos de las marcas líderes a nivel mundial.
				</p>
				
				<div class="flex flex-col sm:flex-row gap-6 mb-6 items-center">
					<a href="https://wa.me/525615429492" class="download-button inline-flex">
						<div class="docs py-3 px-6">
							<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21l1.65-3.8a9 9 0 1 1 3.4 2.9L3 21" /><path d="M9 10a.5.5 0 0 0 1 0V9a.5.5 0 0 0-1 0v1a5 5 0 0 0 5 5h1a.5.5 0 0 0 0-1h-1a.5.5 0 0 0 0 1" /></svg>
							<span class="font-bold text-[15px] tracking-wider uppercase">COTIZAR EQUIPO</span>
						</div>
						<div class="download">
							<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/></svg>
						</div>
					</a>
					<a href="#catalogo" class="more-button inline-flex">
						<div class="docs py-3 px-6">
							<span class="font-bold text-[15px] tracking-wider uppercase">VER OPCIONES</span>
						</div>
						<div class="download">
							<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
						</div>
					</a>
				</div>
			</div>
			
			<div class="relative w-full h-[400px] md:h-[550px] bg-white rounded-3xl shadow-[0_20px_50px_-12px_rgba(0,0,0,0.1)] border border-slate-100 p-2 overflow-hidden flex flex-col items-center justify-center">
                <picture class="contents">
    <source srcset="/images/impresorapag.avif" type="image/avif" />
    <source srcset="/images/impresorapag.webp" type="image/webp" />
    <img src="/images/impresorapag.png" alt="Impresoras PVC" class="w-full h-full object-cover rounded-2xl" / loading="lazy" decoding="async">
</picture>
			</div>
		</div>
	</section>


        </section>

    <!-- Aplicaciones / A quién va dirigido -->
    <section class="py-10 md:py-12 px-6 bg-slate-50 border-b border-light-gray/40">
        <div class="max-w-[1280px] mx-auto">
            <div class="text-center max-w-2xl mx-auto mb-12">
                <div class="flex items-center justify-center gap-3 mb-3">
                    <div class="w-12 h-[2px] bg-corporate-red"></div>
                    <span class="font-sans font-bold text-xs tracking-widest text-corporate-red uppercase">Aplicaciones</span>
                </div>
                <h2 class="font-headings font-bold text-3xl md:text-4xl text-deep-charcoal mb-4">Soluciones para cada industria</h2>
                <p class="font-sans text-medium-gray">Equipos de impresión para toda organización que requiera emitir sus propias credenciales de forma rápida y bajo demanda.</p>
            </div>
            
            <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
                <!-- Sector 1 -->
                <div class="bg-white rounded-2xl p-8 hover:-translate-y-1 transition-transform border border-slate-100 flex flex-col items-center text-center shadow-sm">
                    <div class="w-16 h-16 bg-slate-50 rounded-full flex items-center justify-center mb-4 text-corporate-red">
                        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M4 22V2a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v20"/><path d="M14 22v-6H10v6"/><path d="M8 6h.01"/><path d="M12 6h.01"/><path d="M16 6h.01"/><path d="M8 10h.01"/><path d="M12 10h.01"/><path d="M16 10h.01"/><path d="M8 14h.01"/><path d="M12 14h.01"/><path d="M16 14h.01"/></svg>
                    </div>
                    <h4 class="font-headings font-bold text-deep-charcoal mb-2">Empresas y Corporativos</h4>
                    <p class="font-sans text-xs text-slate-500">Gafetes de empleados, pases de visitantes y control de acceso seguro.</p>
                </div>
                <!-- Sector 2 -->
                <div class="bg-white rounded-2xl p-8 hover:-translate-y-1 transition-transform border border-slate-100 flex flex-col items-center text-center shadow-sm">
                    <div class="w-16 h-16 bg-slate-50 rounded-full flex items-center justify-center mb-4 text-corporate-red">
                        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>
                    </div>
                    <h4 class="font-headings font-bold text-deep-charcoal mb-2">Escuelas y Universidades</h4>
                    <p class="font-sans text-xs text-slate-500">Credenciales escolares de alta durabilidad para alumnos y personal docente.</p>
                </div>
                <!-- Sector 3 -->
                <div class="bg-white rounded-2xl p-8 hover:-translate-y-1 transition-transform border border-slate-100 flex flex-col items-center text-center shadow-sm">
                    <div class="w-16 h-16 bg-slate-50 rounded-full flex items-center justify-center mb-4 text-corporate-red">
                        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                    </div>
                    <h4 class="font-headings font-bold text-deep-charcoal mb-2">Clubes y Gimnasios</h4>
                    <p class="font-sans text-xs text-slate-500">Impresión instantánea de membresías o tarjetas de lealtad para socios.</p>
                </div>
                <!-- Sector 4 -->
                <div class="bg-white rounded-2xl p-8 hover:-translate-y-1 transition-transform border border-slate-100 flex flex-col items-center text-center shadow-sm">
                    <div class="w-16 h-16 bg-slate-50 rounded-full flex items-center justify-center mb-4 text-corporate-red">
                        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/><path d="M8 14h.01"/><path d="M12 14h.01"/><path d="M16 14h.01"/><path d="M8 18h.01"/><path d="M12 18h.01"/><path d="M16 18h.01"/></svg>
                    </div>
                    <h4 class="font-headings font-bold text-deep-charcoal mb-2">Eventos y Exposiciones</h4>
                    <p class="font-sans text-xs text-slate-500">Emisión rápida de gafetes para expositores, visitantes y staff.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Qué puedes hacer con ella / Feature Showcase -->
    <section class="py-20 bg-white px-6 overflow-hidden">
        <div class="max-w-[1280px] mx-auto">
            <div class="grid md:grid-cols-2 gap-16 items-center">
                <!-- Izquierda: Teatro CSS / Imagen de Impresora -->
                <div class="relative w-full aspect-square md:aspect-auto md:h-[600px] flex items-center justify-center p-8 overflow-visible">
                    
                    <!-- Contenedor central (Toda la baraja de 5 tarjetas) -->
                    <div class="relative z-10 w-full h-full min-h-[500px] flex items-start justify-center pt-10">

                        <!-- Magia CSS: Tarjetas apiladas -->
                        <!-- Tarjeta 1 (Fondo profundo) -->
                        <div class="absolute top-[10%] left-1/2 -translate-x-1/2 w-72 h-44 bg-slate-800 rounded-xl shadow-lg border border-slate-600 p-5 z-10 animate-cascade-1 opacity-60">
                            <div class="w-12 h-12 rounded-full bg-slate-600 mb-3"></div>
                            <div class="w-2/3 h-3 bg-slate-600 rounded mb-3"></div>
                            <div class="w-1/3 h-3 bg-slate-600 rounded"></div>
                        </div>

                        <!-- Tarjeta 2 (Atrás) -->
                        <div class="absolute top-[10%] left-1/2 -translate-x-1/2 w-72 h-44 bg-slate-900 rounded-xl shadow-lg border border-slate-700 p-5 z-20 animate-cascade-2 opacity-80">
                            <div class="w-12 h-12 rounded-full bg-slate-700 mb-3"></div>
                            <div class="w-3/4 h-3 bg-slate-700 rounded mb-3"></div>
                            <div class="w-1/2 h-3 bg-slate-700 rounded"></div>
                        </div>
                        
                        <!-- Tarjeta 3 (Medio Centro) -->
                        <div class="absolute top-[10%] left-1/2 -translate-x-1/2 w-72 h-44 bg-gradient-to-br from-corporate-red to-red-700 rounded-xl shadow-[0_20px_40px_-15px_rgba(200,0,0,0.5)] border border-red-500/50 p-5 z-30 animate-cascade-3 opacity-95">
                            <div class="w-12 h-12 rounded-full bg-white/20 mb-3"></div>
                            <div class="w-5/6 h-3 bg-white/20 rounded mb-3"></div>
                            <div class="w-1/2 h-3 bg-white/20 rounded"></div>
                            <div class="absolute bottom-5 right-5 text-white/50">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M4 22V2a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v20"/></svg>
                            </div>
                        </div>

                        <!-- Tarjeta 4 (Frente diagonal) -->
                        <div class="absolute top-[10%] left-1/2 -translate-x-1/2 w-72 h-44 bg-slate-100 rounded-xl shadow-[0_15px_30px_-10px_rgba(0,0,0,0.15)] border border-slate-200 p-5 z-40 animate-cascade-4">
                            <div class="w-12 h-12 rounded-full bg-slate-300 mb-3"></div>
                            <div class="w-3/4 h-3 bg-slate-300 rounded mb-3"></div>
                            <div class="w-1/2 h-3 bg-slate-200 rounded"></div>
                        </div>

                        <!-- Tarjeta 5 (Frente / Principal) -->
                        <div class="absolute top-[10%] left-1/2 -translate-x-1/2 w-72 h-44 bg-white rounded-xl shadow-[0_25px_50px_-12px_rgba(0,0,0,0.25)] border border-slate-100 p-5 z-50 animate-cascade-5 hover:scale-105 cursor-pointer transition-transform duration-300">
                            <div class="w-12 h-12 rounded-full bg-slate-100 mb-3 flex items-center justify-center text-corporate-red">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                            </div>
                            <div class="w-3/4 h-3 bg-slate-200 rounded mb-3"></div>
                            <div class="w-1/2 h-3 bg-slate-100 rounded"></div>
                            <div class="w-full h-5 mt-5 url-pattern bg-[repeating-linear-gradient(45deg,transparent,transparent_2px,#f1f5f9_2px,#f1f5f9_4px)] rounded-sm"></div>
                        </div>
                    </div>
                </div>

                <!-- Derecha: Texto y Capacidades -->
                <div>
                    <div class="flex items-center gap-3 mb-4">
                        <span class="w-10 h-[2px] bg-corporate-red"></span>
                        <span class="font-headings font-bold text-xs tracking-[0.2em] text-corporate-red uppercase">Emisión In-House</span>
                    </div>
                    <h2 class="font-headings font-extrabold text-3xl md:text-5xl text-deep-charcoal mb-6 leading-tight">
                        Absoluto control sobre tus <span class="text-corporate-red">credenciales</span>
                    </h2>
                    <p class="font-sans text-slate-500 mb-10 text-lg leading-relaxed">
                        Tener tu propia impresora PVC te libera de las dependencias externas. Desde gafetes de emergencia hasta tirajes masivos codificados en alta seguridad, todo se imprime en tu escritorio.
                    </p>

                    <div class="space-y-6">
                        <!-- Feature 1 -->
                        <div class="flex gap-4">
                            <div class="w-12 h-12 rounded-full bg-red-50 flex items-center justify-center shrink-0 text-corporate-red">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M12 2v20"/><path d="m17 5-5-3-5 3"/><path d="m7 19 5 3 5-3"/></svg>
                            </div>
                            <div>
                                <h4 class="font-headings font-bold text-xl text-deep-charcoal mb-1">Impresión Bajo Demanda</h4>
                                <p class="font-sans text-sm text-slate-500">¿Entró un nuevo empleado o se perdió un gafete? Imprímelo inmediatamente en menos de 30 segundos sin esperar días por un proveedor.</p>
                            </div>
                        </div>
                        
                        <!-- Feature 2 -->
                        <div class="flex gap-4">
                            <div class="w-12 h-12 rounded-full bg-red-50 flex items-center justify-center shrink-0 text-corporate-red">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                            </div>
                            <div>
                                <h4 class="font-headings font-bold text-xl text-deep-charcoal mb-1">Seguridad y Codificación</h4>
                                <p class="font-sans text-sm text-slate-500">Integra módulos para banda magnética, chips RFID UHF, marcas de agua holográficas o laminado UV directo desde tu equipo.</p>
                            </div>
                        </div>

                        <!-- Feature 3 -->
                        <div class="flex gap-4">
                            <div class="w-12 h-12 rounded-full bg-red-50 flex items-center justify-center shrink-0 text-corporate-red">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="m16 10-4 4-4-4"/></svg>
                            </div>
                            <div>
                                <h4 class="font-headings font-bold text-xl text-deep-charcoal mb-1">Calidad Edge-to-Edge</h4>
                                <p class="font-sans text-sm text-slate-500">Tecnología de retransferencia térmica para colores vibrantes que cubren la tarjeta al 100%, sin bordes blancos e imagen fotográfica.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Ecosistema Completo (Tarjetas Detalladas) -->
    <section id="catalogo" class="py-24 bg-slate-50 px-6">
        <div class="max-w-[1280px] mx-auto">
            <div class="text-center max-w-2xl mx-auto mb-16">
                <div class="flex items-center justify-center gap-3 mb-4">
                    <div class="w-12 h-[2px] bg-corporate-red"></div>
                    <span class="font-sans font-bold text-xs tracking-widest text-corporate-red uppercase">Ecosistema Completo</span>
                    <div class="w-12 h-[2px] bg-corporate-red"></div>
                </div>
                <h2 class="font-headings font-bold text-3xl md:text-4xl text-deep-charcoal mb-4">Todo lo que necesitas</h2>
            </div>
            
            <div class="max-w-6xl mx-auto">
                
                <!-- Encabezado Principal -->
                <div class="bg-gradient-to-br from-deep-charcoal to-[#1a1a24] rounded-3xl p-0 border border-gray-100/10 shadow-lg mb-8 flex flex-col md:flex-row overflow-hidden text-white relative">
                    <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(#fff 1px, transparent 1px); background-size: 20px 20px;"></div>
                    
                    <div class="p-8 md:p-10 md:w-3/5 relative z-10 flex flex-col justify-center">
                        <div class="flex items-center gap-3 mb-4">
                            <span class="font-sans font-bold text-xs tracking-widest text-corporate-red uppercase">Emisión In-House</span>
                        </div>
                        <h3 class="font-headings font-bold text-2xl md:text-3xl mb-4">Impresoras Especializadas</h3>
                        <p class="font-sans text-sm md:text-base text-slate-300 leading-relaxed max-w-lg">
                            Equipos robustos configurados para bajo, medio y alto volumen. Todo integrado nativamente con software de diseño para controlar la producción desde el primer día.
                        </p>
                    </div>
                    <div class="w-full md:w-2/5 min-h-[200px] bg-slate-800/50 backdrop-blur-sm border-l border-white/10 flex flex-col items-center justify-center p-6 relative z-10 overflow-hidden group">
                        <!-- Impresora con hoja animada (Solo visual sin texto) -->
                        <div class="relative w-32 h-32 flex flex-col items-center justify-end overflow-hidden">
                            <!-- Gafete/Tarjeta saliendo -->
                            <div class="w-14 h-20 bg-white rounded-md absolute top-3 z-10 transition-transform duration-1000 ease-out translate-y-8 group-hover:-translate-y-2 flex flex-col shadow-inner pt-1 px-1.5 opacity-80 group-hover:opacity-100 border border-slate-200">
                                <!-- Perforación para lanyard -->
                                <div class="w-3 h-1 bg-slate-200/80 rounded-full mx-auto mb-1.5"></div>
                                <!-- Foto -->
                                <div class="w-5 h-5 bg-slate-200 rounded-sm mx-auto mb-1.5 flex items-center justify-center overflow-hidden">
                                    <div class="w-3 h-3 bg-slate-300 rounded-full mt-2"></div>
                                </div>
                                <!-- Texto -->
                                <div class="w-full h-0.5 bg-slate-300 rounded-full mb-1"></div>
                                <div class="w-4/5 h-0.5 bg-slate-300 rounded-full mx-auto mb-1.5"></div>
                                <!-- Banda de color -->
                                <div class="w-full h-1.5 bg-corporate-red/80 mt-auto rounded-sm mb-1"></div>
                            </div>
                            <!-- Cuerpo impresora -->
                            <div class="w-24 h-12 bg-slate-700/80 backdrop-blur border border-slate-500 rounded-lg relative z-20 shadow-xl flex items-center justify-center">
                                <div class="w-16 h-1 bg-slate-900 rounded-full absolute top-2"></div>
                                <div class="flex gap-1 absolute bottom-2 right-2">
                                    <div class="w-1.5 h-1.5 bg-green-500 rounded-full animate-pulse shadow-[0_0_5px_rgba(34,197,94,0.8)]"></div>
                                    <div class="w-1.5 h-1.5 bg-blue-500 rounded-full"></div>
                                </div>
                            </div>
                            <!-- Bandeja salida -->
                            <div class="w-20 h-4 bg-slate-600 rounded-b-md relative z-30 shadow-md"></div>
                        </div>
                    </div>
                </div>

                <!-- Grid Único de Características (Impresión + Gestión) -->
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 xl:gap-6 auto-rows-min">
                    <!-- Card: Una/Dos Caras -->
                    <div class="bg-white rounded-3xl p-8 border border-gray-100 shadow-sm hover:shadow-md transition-all group overflow-hidden relative lg:col-span-1">
                        <div class="absolute -right-6 -bottom-6 opacity-[0.03] text-corporate-red transform group-hover:scale-110 transition-transform duration-500 pointer-events-none">
                            <svg xmlns="http://www.w3.org/2000/svg" width="160" height="160" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
                        </div>
                        <div class="relative z-10 h-full flex flex-col justify-start">
                            <h3 class="font-headings font-bold text-xl text-deep-charcoal mb-3">Una / Dos Caras</h3>
                            <p class="font-sans text-sm text-medium-gray leading-relaxed">
                                Módulos de volteo integrados para imprimir ambos lados del gafete en un solo paso, optimizando tiempos drásticamente.
                            </p>
                        </div>
                    </div>
                    
                    <!-- Card: Etiquetas RFID -->
                    <div class="bg-white rounded-3xl p-8 border border-gray-100 shadow-sm hover:shadow-md transition-all group overflow-hidden relative lg:col-span-1">
                        <div class="absolute -right-6 -bottom-6 opacity-[0.03] text-corporate-red transform group-hover:scale-110 transition-transform duration-500 pointer-events-none">
                            <svg xmlns="http://www.w3.org/2000/svg" width="160" height="160" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 22h14a2 2 0 0 0 2-2V7l-5-5H6a2 2 0 0 0-2 2v4"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M3 15h6"/><path d="M3 18h6"/></svg>
