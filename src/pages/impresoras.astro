<script>
    document.addEventListener('DOMContentLoaded', () => {
        // Implementación de las Interactive Morphing Cards (FAQ)
        const faqCards = document.querySelectorAll('.faq-card');
        
        faqCards.forEach(card => {
            card.addEventListener('click', () => {
                // Cerrar las otras que estén abiertas (Acordeón único) - Opcional
                faqCards.forEach(otherCard => {
                    if (otherCard !== card && otherCard.classList.contains('is-open')) {
                        otherCard.classList.remove('is-open');
                    }
                });
                
                // Alternar el estado open de la interactuada
                card.classList.toggle('is-open');
            });
        });
    });
</script>