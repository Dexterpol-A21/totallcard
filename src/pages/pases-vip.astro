---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Lanyard from '../components/Lanyard.jsx';
import Footer from '../components/Footer.astro';
---

<Layout 
	title="Gafetes y Credenciales VIP Oversize para Eventos | TOTALLCARD" 
	description="Pases VIP, gafetes oversize y acreditaciones para eventos, conciertos y exposiciones. Controla los accesos con credenciales de PVC de la más alta seguridad."
	keywords="pases VIP, gafetes para eventos, credenciales oversize, gafetes para conciertos, gafetes de staff, acreditaciones, pases de prensa, impresión PVC"
>
	<div class="hidden lg:flex fixed inset-0 z-[100] pointer-events-none w-screen h-screen">
		<Lanyard client:media="(min-width: 1024px)" position={[0, 0, 45]} gravity={[0, -40, 0]} />
	</div>
	<Header submenu="tarjetas" active="CREDENCIALES PARA EVENTOS" />

	<!-- Hero Section: Gafetes Empresariales -->
	<section class="lg:min-h-[85vh] flex items-start lg:items-center pt-8 pb-8 lg:pt-40 md:pb-12 px-6 bg-white overflow-hidden relative">
		<div class="max-w-[1280px] mx-auto grid md:grid-cols-2 gap-8 items-center w-full">
			<div class="z-10">
				<p class="font-headings text-corporate-red font-bold text-xs md:text-sm tracking-widest uppercase mb-4">
					Accesos Exclusivos.
				</p>
				<h1 class="font-headings font-extrabold text-4xl md:text-5xl lg:text-6xl text-deep-charcoal leading-[1.1] mb-6">
							Pases y Gafetes para Eventos
						</h1>
				<p class="font-sans text-base md:text-lg text-medium-gray mb-6 max-w-xl">
					Identificación profesional, segura y con estilo para los colaboradores de tu empresa. Refuerza la identidad corporativa y asegura tus instalaciones.
				</p>
				
				<div class="flex flex-col sm:flex-row gap-6 mb-6 items-center">
					<a href="https://wa.me/525615429492" class="download-button inline-flex">
						<div class="docs py-3 px-6">
							<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21l1.65-3.8a9 9 0 1 1 3.4 2.9L3 21" /><path d="M9 10a.5.5 0 0 0 1 0V9a.5.5 0 0 0-1 0v1a5 5 0 0 0 5 5h1a.5.5 0 0 0 0-1h-1a.5.5 0 0 0 0 1" /></svg>
							<span class="font-bold text-[15px] tracking-wider uppercase">COTIZACIÓN POR WHATSAPP</span>
						</div>
						<div class="download">
							<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/></svg>
						</div>
					</a>
				</div>
                
                <div class="flex flex-wrap md:flex-nowrap justify-start gap-6 md:gap-8 pt-2">
                    <div class="flex flex-row items-center gap-4 w-full md:w-auto">
                        <div class="w-12 h-12 rounded bg-light-gray/40 flex items-center justify-center shrink-0">
                            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-corporate-red"><rect x="3" y="4" width="18" height="16" rx="2" ry="2"></rect><line x1="8" y1="2" x2="8" y2="6"></line><line x1="16" y1="2" x2="16" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                        </div>
                        <span class="font-headings font-bold text-[11px] md:text-xs uppercase tracking-widest text-deep-charcoal leading-snug">Impresión<br />HD</span>
                    </div>
                    <div class="flex flex-row items-center gap-4 w-full md:w-auto">
                        <div class="w-12 h-12 rounded bg-light-gray/40 flex items-center justify-center shrink-0">
                            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-corporate-red"><path d="M4 11a9 9 0 0 1 9 9"></path><path d="M4 4a16 16 0 0 1 16 16"></path><circle cx="5" cy="19" r="1"></circle></svg>
                        </div>
                        <span class="font-headings font-bold text-[11px] md:text-xs uppercase tracking-widest text-deep-charcoal leading-snug">Tecnología<br />RFID / NFC</span>
                    </div>
                    <div class="flex flex-row items-center gap-4 w-full md:w-auto">
                        <div class="w-12 h-12 rounded bg-light-gray/40 flex items-center justify-center shrink-0">
                            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-corporate-red"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
                        </div>
                        <span class="font-headings font-bold text-[11px] md:text-xs uppercase tracking-widest text-deep-charcoal leading-snug">Alta<br />Durabilidad</span>
                    </div>
                </div>
			</div>
			
			<div class="relative w-full h-[350px] md:h-[500px]">
                <div class="w-full h-[300px] md:h-full relative z-10 pointer-events-none select-none">
                    <picture class="contents">
    <source srcset="/images/vip.avif" type="image/avif" />
    <source srcset="/images/vip.webp" type="image/webp" />
    <img draggable="false" src="/images/vip.png" alt="Pases VIP" class="w-full h-full object-cover relative z-10 rounded-[2rem] shadow-2xl border-[8px] border-white pointer-events-none select-none" / loading="lazy" decoding="async">
</picture>
                </div>
			</div>
		</div>
	</section>

        <!-- Aplicaciones / A quién va dirigido -->
        <section class="py-10 md:py-12 px-6 bg-slate-50 border-b border-light-gray/40">
            <div class="max-w-[1280px] mx-auto">
                <div class="text-center max-w-2xl mx-auto mb-12">
                    <div class="flex items-center justify-center gap-3 mb-3">
                        <div class="w-12 h-[2px] bg-corporate-red"></div>
                        <span class="font-sans font-bold text-xs tracking-widest text-corporate-red uppercase">Aplicaciones</span>
                    </div>
                    <h2 class="font-headings font-bold text-3xl md:text-4xl text-deep-charcoal mb-4">¿Dónde utilizar Pases VIP y Gafetes Oversize?</h2>
                    <p class="font-sans text-medium-gray">Formatos de alto impacto visual diseñados para organizar staff y asistentes especiales en multitudes.</p>
                </div>
                
                <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
                    <!-- Sector 1 -->
                    <div class="bg-white rounded-2xl p-8 hover:-translate-y-1 transition-transform border border-slate-100 flex flex-col items-center text-center shadow-sm">
                        <div class="w-16 h-16 bg-slate-50 rounded-full flex items-center justify-center mb-4 text-corporate-red">
                            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>
                        </div>
                        <h4 class="font-headings font-bold text-deep-charcoal mb-2">Conciertos y Festivales</h4>
                        <p class="font-sans text-xs text-slate-500">Pases exclusivos para backstage, meet & greet y zonas preferentes.</p>
                    </div>
                    <!-- Sector 2 -->
                    <div class="bg-white rounded-2xl p-8 hover:-translate-y-1 transition-transform border border-slate-100 flex flex-col items-center text-center shadow-sm">
                        <div class="w-16 h-16 bg-slate-50 rounded-full flex items-center justify-center mb-4 text-corporate-red">
                            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                        </div>
                        <h4 class="font-headings font-bold text-deep-charcoal mb-2">Congresos y Expos</h4>
                        <p class="font-sans text-xs text-slate-500">Gafetes de mayor tamaño para leer códigos desde lejos.</p>
                    </div>
                    <!-- Sector 3 -->
                    <div class="bg-white rounded-2xl p-8 hover:-translate-y-1 transition-transform border border-slate-100 flex flex-col items-center text-center shadow-sm">
                        <div class="w-16 h-16 bg-slate-50 rounded-full flex items-center justify-center mb-4 text-corporate-red">
                            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/></svg>
                        </div>
                        <h4 class="font-headings font-bold text-deep-charcoal mb-2">Eventos Deportivos</h4>
                        <p class="font-sans text-xs text-slate-500">Pases de prensa y zonas exclusivas.</p>
                    </div>
                    <!-- Sector 4 -->
                    <div class="bg-white rounded-2xl p-8 hover:-translate-y-1 transition-transform border border-slate-100 flex flex-col items-center text-center shadow-sm">
                        <div class="w-16 h-16 bg-slate-50 rounded-full flex items-center justify-center mb-4 text-corporate-red">
                            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                        </div>
                        <h4 class="font-headings font-bold text-deep-charcoal mb-2">Convenciones Privadas</h4>
                        <p class="font-sans text-xs text-slate-500">Acreditaciones para invitados honorarios o VIP.</p>
                    </div>
                </div>
            </div>
        </section>

	<!-- Diagrama / Infografía de Credencial -->
        <section class="py-10 md:py-12 px-6 bg-white relative overflow-hidden border-b border-light-gray/40">
        <div class="max-w-[1280px] mx-auto text-center mb-16 relative z-10">
            <h2 class="font-headings font-bold text-3xl md:text-4xl text-deep-charcoal mb-4">Anatomía de un Pase VIP</h2>
            <p class="font-sans text-medium-gray max-w-2xl mx-auto">Detalles de lujo y holografías. Conoce cómo elevamos la experiencia de los accesos exclusivos mediante acabados de alta gama.</p>
        </div>

        <div class="max-w-[1000px] mx-auto relative flex flex-col items-center justify-center min-h-[500px] lg:min-h-[550px] z-10">
            
            <!-- TARJETA CENTRAL -->
                <!-- Item 9 (Eventos/VIP/Acreditaciones - PVC Alto con Perforación) -->
                <div class="pvc-card z-30 transform hover:scale-105 transition-transform duration-500 w-full has-punch deal-ready group overflow-hidden bg-white flex flex-col pt-10 pb-0 px-0 rounded-[1rem] relative border border-slate-200 shadow-[0_4px_15px_rgba(0,0,0,0.05),0_15px_35px_rgba(0,0,0,0.05)] aspect-[86/54] lg:max-w-[400px] mx-auto text-slate-800 transition-all duration-700 hover:-translate-y-3 hover:rotate-1 hover:shadow-[0_20px_40px_rgba(0,0,0,0.12)]" >

                    <!-- Header Evento (Datos de Gafete Real) -->
                    <div class="px-6 flex justify-between items-start w-full">
                        <div class="flex flex-col">
                            <span class="font-headings font-black text-slate-800 text-lg md:text-xl tracking-tight leading-none uppercase">SUMMIT <span class="text-fuchsia-600">2026</span></span>
                            <span class="text-slate-400 font-sans text-[8px] md:text-[9px] font-bold tracking-widest mt-1">GLOBAL CONFERENCE PASSPORT</span>
                        </div>
                        
                        <!-- Mini QR Code para escanear en stands -->
                        <div class="bg-white p-1 rounded border border-slate-200 shadow-sm opacity-90">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#0f172a" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/>
                                <path d="M6 6h.01"/><path d="M17 6h.01"/><path d="M17 17h.01"/><path d="M6 17h.01"/>
                                <path d="M10 10h4v4h-4z"/>
                            </svg>
                        </div>
                    </div>

                    <!-- Contenido Central: Textos informativos de la UI -->
                    <div class="px-6 mt-3 flex-1 flex flex-col justify-start">
						<h3 class="font-headings font-bold text-lg md:text-xl mb-1 text-slate-800 leading-tight">Credencialización para eventos</h3>
						<p class="font-sans text-[11px] md:text-[12px] text-slate-500 leading-relaxed pr-4">Acreditaciones personalizadas para eventos, conferencias y convenciones con data variable.</p>
					</div>

                    <!-- Bottom Band (Nivel de Acceso) -->
                    <div class="relative w-full h-12 bg-gradient-to-r from-fuchsia-600 to-orange-500 flex items-center justify-between px-6 overflow-hidden mt-auto">
                        <!-- Holograma reflectivo al pasar el cursor -->
                        <div class="absolute inset-0 bg-gradient-to-r from-white/0 via-white/30 to-white/0 translate-x-[-150%] group-hover:translate-x-[150%] transition-transform duration-1000 ease-in-out"></div>
                        
                        <div class="inline-flex items-center space-x-2 relative z-10">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-white"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
                            <span class="text-white font-sans text-xs md:text-sm font-black tracking-widest uppercase" style="text-shadow: 0 1px 2px rgba(0,0,0,0.2);">ALL ACCESS VIP</span>
                        </div>
                        
                        <!-- Call to action arrow -->
                        <div class="text-white opacity-70 group-hover:opacity-100 group-hover:translate-x-1 transition-all relative z-10">
                             <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
                        </div>
                    </div>
				</div>

            <!-- ANOTACIONES Y LÍNEAS (Desktop/LG) -->
            <div class="hidden lg:block absolute inset-0 pointer-events-none z-20">
                
                <!-- Apunte 1: Perforación (Arriba Izquierda) -->
                <div class="absolute top-[5%] left-[-15%] text-right w-[320px]">
                    <div class="bg-white p-4 rounded-xl shadow-lg border border-slate-100 inline-block pointer-events-auto hover:-translate-y-1 transition-transform">
                        <div class="flex items-center gap-2 mb-1 justify-end">
                            <h4 class="font-headings font-bold text-deep-charcoal">Perforación Estándar</h4>
                            <div class="w-2 h-2 rounded-full bg-corporate-red"></div>
                        </div>
                        <p class="font-sans text-xs text-slate-500">Slot compatible con broches, yoyos y lanyards de cualquier tipo.</p>
                    </div>
                    <!-- Línea SVG -->
                    <svg class="absolute top-1/2 left-[100%] ml-2 w-[160px] h-[60px] overflow-visible" style="transform: translateY(-50%)">
                        <path d="M0,30 Q80,30 160,80" fill="none" stroke="#cbd5e1" stroke-width="2" stroke-dasharray="4,4" />
                        <circle cx="160" cy="80" r="4" fill="#e1061a" />
                    </svg>
                </div>

                <!-- Apunte 2: Diseño Institucional (Centro Derecha) -->
                <div class="absolute top-[25%] right-[-15%] text-left w-[320px]">
                    <div class="bg-white p-4 rounded-xl shadow-lg border border-slate-100 inline-block pointer-events-auto hover:-translate-y-1 transition-transform">
                        <div class="flex items-center gap-2 mb-1 justify-start">
                            <div class="w-2 h-2 rounded-full bg-corporate-red"></div>
                            <h4 class="font-headings font-bold text-deep-charcoal">Diseño Corporativo</h4>
                        </div>
                        <p class="font-sans text-xs text-slate-500">Integración de logotipos y colores exactos de manual de marca.</p>
                    </div>
                    <!-- Línea SVG -->
                    <svg class="absolute top-1/2 right-[100%] mr-2 w-[160px] h-[40px] overflow-visible" style="transform: translateY(-50%)">
                        <path d="M160,20 Q80,20 0,90" fill="none" stroke="#cbd5e1" stroke-width="2" stroke-dasharray="4,4" />
                        <circle cx="0" cy="90" r="4" fill="#e1061a" />
                    </svg>
                </div>

                <!-- Apunte 3: Foto (Centro Izquierda) -->
                <div class="absolute top-[45%] left-[-15%] text-right w-[320px]">
                    <div class="bg-white p-4 rounded-xl shadow-lg border border-slate-100 inline-block pointer-events-auto hover:-translate-y-1 transition-transform">
                        <div class="flex items-center gap-2 mb-1 justify-end">
                            <h4 class="font-headings font-bold text-deep-charcoal">Resolución Fotográfica</h4>
                            <div class="w-2 h-2 rounded-full bg-corporate-red"></div>
                        </div>
                        <p class="font-sans text-xs text-slate-500">Tecnología re-transferencia, resalta rostros sin perder detalle.</p>
                    </div>
                    <!-- Línea SVG -->
                    <svg class="absolute top-1/2 left-[100%] ml-2 w-[180px] h-[20px] overflow-visible" style="transform: translateY(-50%)">
                        <path d="M0,10 L160,10" fill="none" stroke="#cbd5e1" stroke-width="2" stroke-dasharray="4,4" />
                        <circle cx="160" cy="10" r="4" fill="#e1061a" />
                    </svg>
                </div>

                <!-- Apunte 4: Seguridad (Abajo Derecha) -->
                <div class="absolute top-[75%] right-[-15%] text-left w-[320px]">
                    <div class="bg-white p-4 rounded-xl shadow-lg border border-slate-100 inline-block pointer-events-auto hover:-translate-y-1 transition-transform">
                        <div class="flex items-center gap-2 mb-1 justify-start">
                            <div class="w-2 h-2 rounded-full bg-corporate-red"></div>
                            <h4 class="font-headings font-bold text-deep-charcoal">Tecnología Opcional</h4>
                        </div>
                        <p class="font-sans text-xs text-slate-500">Códigos 1D/2D, QR o embutido de chips rfid (MiFare, Proximidad).</p>
                    </div>
                    <!-- Línea SVG -->
                    <svg class="absolute top-1/2 right-[100%] mr-2 w-[180px] h-[60px] overflow-visible" style="transform: translateY(-50%)">
                        <path d="M180,30 Q90,30 20,-10" fill="none" stroke="#cbd5e1" stroke-width="2" stroke-dasharray="4,4" />
                        <circle cx="20" cy="-10" r="4" fill="#e1061a" />
                    </svg>
                </div>

            </div>
            
            <!-- ANOTACIONES MOBILE (Lista debajo de la tarjeta en móvil) -->
            <div class="lg:hidden w-full mt-10 grid gap-4 grid-cols-1 sm:grid-cols-2 text-left relative z-20">
                <div class="bg-white p-4 rounded-xl shadow-sm border border-slate-100">
                    <h4 class="font-headings font-bold text-deep-charcoal mb-1 flex items-center gap-2"><span class="text-corporate-red">&bull;</span> Perforación Estándar</h4>
                    <p class="font-sans text-xs text-slate-500">Slot compatible con todos nuestros portagafetes y lanyards.</p>
                </div>
                <div class="bg-white p-4 rounded-xl shadow-sm border border-slate-100">
                    <h4 class="font-headings font-bold text-deep-charcoal mb-1 flex items-center gap-2"><span class="text-corporate-red">&bull;</span> Diseño Corporativo</h4>
                    <p class="font-sans text-xs text-slate-500">Integración de logotipos y manual de marca exactos.</p>
                </div>
                <div class="bg-white p-4 rounded-xl shadow-sm border border-slate-100">
                    <h4 class="font-headings font-bold text-deep-charcoal mb-1 flex items-center gap-2"><span class="text-corporate-red">&bull;</span> Resolución Fotográfica</h4>
                    <p class="font-sans text-xs text-slate-500">Impresión brillante que resalta rostros sin distorsión.</p>
                </div>
                <div class="bg-white p-4 rounded-xl shadow-sm border border-slate-100">
                    <h4 class="font-headings font-bold text-deep-charcoal mb-1 flex items-center gap-2"><span class="text-corporate-red">&bull;</span> Tecnología</h4>
                    <p class="font-sans text-xs text-slate-500">Códigos de barras, QR o chips RFID de proximidad.</p>
                </div>
            </div>

        </div>
	</section>

        <!-- Nuestro Proceso de Compra -->
        <section class="py-10 md:py-12 bg-white px-6">
                <div class="max-w-[1280px] mx-auto">
                        <div class="mb-12">
                                <div class="flex items-center gap-3 mb-3">
                                        <div class="w-12 h-[2px] bg-corporate-red"></div>
                                        <span class="font-sans font-bold text-xs tracking-widest text-corporate-red uppercase">Metodología</span>
                                </div>
                                <h2 class="font-headings font-bold text-3xl md:text-4xl text-deep-charcoal">Nuestro Proceso, Tu Tranquilidad</h2>
                        </div>

                        <div class="bg-white border text-deep-charcoal border-gray-100 rounded-[24px] shadow-[0_8px_30px_rgba(0,0,0,0.04)] p-8 md:p-10 max-w-full overflow-hidden relative">
                                <div class="flex flex-col lg:flex-row items-start lg:items-center justify-between min-w-full lg:min-w-[1000px] gap-8 lg:gap-4 xl:gap-8">
                                        
                                        <!-- Step 1 -->
                                        <div class="flex items-start gap-4 flex-1">
                                                <div class="w-12 h-12 flex items-center justify-center shrink-0 text-deep-charcoal">
                                                        <svg xmlns="http://www.w3.org/2000/svg" width="38" height="38" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/><path d="m15 5 3 3"/></svg>
                                                </div>
                                                <div>
                                                        <div class="flex items-center gap-3 mb-1">
                                                                <span class="font-headings font-black text-2xl text-deep-charcoal leading-none">1</span>
                                                                <h4 class="font-headings font-bold text-[17px] text-deep-charcoal leading-none">Diseño</h4>
                                                        </div>
