---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Lanyard from '../components/Lanyard.jsx';
import Footer from '../components/Footer.astro';
---

<Layout 
        title="Lanyards Personalizados y Portagafetes Corporativos | TOTALLCARD" 
        description="Fabricación de lanyards personalizados, cintas impresas y portagafetes corporativos. Igualamos tu Pantone, alta durabilidad y envíos a todo México. ¡Cotiza hoy!"
        keywords="lanyards personalizados, portagafetes, cintas impresas para gafetes, lanyards corporativos, lanyards sublimados, yoyos retractiles, porta credenciales, mexico"
>
        <!-- Lanyard global CTA -->
        <div class="hidden lg:flex fixed inset-0 z-[100] pointer-events-none w-screen h-screen">
            <Lanyard client:only="react" position={[0, 0, 45]} gravity={[0, -40, 0]} />
        </div>
        <Header submenu="equipos" active="PORTAGAFETES Y LANYARDS" />

        <!-- Hero Section -->	<section class="lg:min-h-[85vh] flex items-start lg:items-center pt-8 pb-8 lg:pt-40 md:pb-12 px-6 bg-slate-50 relative overflow-hidden">
		<div class="max-w-[1280px] mx-auto grid md:grid-cols-2 gap-8 items-center w-full relative z-10">
			<div>
				<p class="font-headings text-corporate-red font-bold text-xs md:text-sm tracking-widest uppercase mb-4 flex items-center gap-2">
                    <span class="w-8 h-[2px] bg-corporate-red"></span>
					Línea de Accesorios
				</p>
				<h1 class="font-headings font-extrabold text-4xl md:text-5xl lg:text-6xl text-deep-charcoal leading-[1.1] mb-6">
					Portagafetes y<br />Lanyards Premium
				</h1>
				<p class="font-sans text-base md:text-lg text-medium-gray mb-6 max-w-xl leading-relaxed">
					Protege, porta y luce tus acreditaciones con nuestra línea de accesorios diseñados para resistir el uso diario y destacar tu marca en todo momento.
				</p>
				
				<div class="flex flex-col sm:flex-row gap-6 mb-6 items-center">
					<a href="https://wa.me/525615429492" class="download-button inline-flex">
						<div class="docs py-3 px-6">
							<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21l1.65-3.8a9 9 0 1 1 3.4 2.9L3 21" /><path d="M9 10a.5.5 0 0 0 1 0V9a.5.5 0 0 0-1 0v1a5 5 0 0 0 5 5h1a.5.5 0 0 0 0-1h-1a.5.5 0 0 0 0 1" /></svg>
							<span class="font-bold text-[15px] tracking-wider uppercase">PIDE CATÁLOGO</span>
						</div>
						<div class="download">
							<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/></svg>
						</div>
					</a>
					<a href="#catalogo" class="more-button alt-button inline-flex">
						<div class="docs py-3 px-6">
							<span class="font-bold text-[15px] tracking-wider uppercase">VER OPCIONES</span>
						</div>
						<div class="download">
							<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
						</div>
					</a>
				</div>
			</div>
			
			<div class="relative w-full h-[400px] md:h-[550px] bg-white rounded-3xl shadow-[0_20px_50px_-12px_rgba(0,0,0,0.1)] border border-slate-100 p-2 overflow-hidden flex flex-col items-center justify-center">
                <picture class="contents">
    <source srcset="/images/layardpag.avif" type="image/avif" />
    <source srcset="/images/layardpag.webp" type="image/webp" />
    <img src="/images/layardpag.webp" alt="Lanyards corporativos y portagafetes" class="w-full h-full object-cover rounded-2xl" loading="lazy" decoding="async" />
</picture>
			</div>
		</div>
	</section>


        </section>

    <!-- Aplicaciones / A quién va dirigido -->
    <section class="py-10 md:py-12 px-6 bg-slate-50 border-b border-light-gray/40">
        <div class="max-w-[1280px] mx-auto">
            <div class="text-center max-w-2xl mx-auto mb-12">
                <div class="flex items-center justify-center gap-3 mb-3">
                    <div class="w-12 h-[2px] bg-corporate-red"></div>
                    <span class="font-sans font-bold text-xs tracking-widest text-corporate-red uppercase">Aplicaciones</span>
                </div>
                <h2 class="font-headings font-bold text-3xl md:text-4xl text-deep-charcoal mb-4">Soluciones para cada industria</h2>
                <p class="font-sans text-medium-gray">Accesorios premium y lanyards para toda organización que requiera portar su identidad con seguridad y estilo corporativo.</p>
            </div>
            
            <div class="flex overflow-x-auto snap-x snap-mandatory gap-6 pb-6 px-4 md:px-0 [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden md:grid md:grid-cols-4 md:overflow-visible w-[calc(100%+2rem)] -ml-4 md:w-full md:ml-0 relative">
                <!-- Sector 1 -->
                <div class="min-w-[280px] w-[85vw] snap-center shrink-0 md:min-w-0 md:w-auto bg-white rounded-2xl p-8 hover:-translate-y-1 transition-transform border border-slate-100 flex flex-col items-center text-center shadow-sm">
                    <div class="w-16 h-16 bg-slate-50 rounded-full flex items-center justify-center mb-4 text-corporate-red">
                        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M4 22V2a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v20"/><path d="M14 22v-6H10v6"/><path d="M8 6h.01"/><path d="M12 6h.01"/><path d="M16 6h.01"/><path d="M8 10h.01"/><path d="M12 10h.01"/><path d="M16 10h.01"/><path d="M8 14h.01"/><path d="M12 14h.01"/><path d="M16 14h.01"/></svg>
                    </div>
                    <h4 class="font-headings font-bold text-deep-charcoal mb-2">Empresas y Corporativos</h4>
                    <p class="font-sans text-xs text-slate-500">Lanyards ejecutivos para gafetes de empleados y pases de visitantes.</p>
                </div>
                <!-- Sector 2 -->
                <div class="min-w-[280px] w-[85vw] snap-center shrink-0 md:min-w-0 md:w-auto bg-white rounded-2xl p-8 hover:-translate-y-1 transition-transform border border-slate-100 flex flex-col items-center text-center shadow-sm">
                    <div class="w-16 h-16 bg-slate-50 rounded-full flex items-center justify-center mb-4 text-corporate-red">
                        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>
                    </div>
                    <h4 class="font-headings font-bold text-deep-charcoal mb-2">Escuelas y Universidades</h4>
                    <p class="font-sans text-xs text-slate-500">Portacredenciales y cintas de alta durabilidad para alumnos y docentes.</p>
                </div>
                <!-- Sector 3 -->
                <div class="min-w-[280px] w-[85vw] snap-center shrink-0 md:min-w-0 md:w-auto bg-white rounded-2xl p-8 hover:-translate-y-1 transition-transform border border-slate-100 flex flex-col items-center text-center shadow-sm">
                    <div class="w-16 h-16 bg-slate-50 rounded-full flex items-center justify-center mb-4 text-corporate-red">
                        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                    </div>
                    <h4 class="font-headings font-bold text-deep-charcoal mb-2">Clubes y Gimnasios</h4>
                    <p class="font-sans text-xs text-slate-500">Yoyos retráctiles y micas rígidas para tarjetas de lealtad y membresías.</p>
                </div>
                <!-- Sector 4 -->
                <div class="min-w-[280px] w-[85vw] snap-center shrink-0 md:min-w-0 md:w-auto bg-white rounded-2xl p-8 hover:-translate-y-1 transition-transform border border-slate-100 flex flex-col items-center text-center shadow-sm">
                    <div class="w-16 h-16 bg-slate-50 rounded-full flex items-center justify-center mb-4 text-corporate-red">
                        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/><path d="M8 14h.01"/><path d="M12 14h.01"/><path d="M16 14h.01"/><path d="M8 18h.01"/><path d="M12 18h.01"/><path d="M16 18h.01"/></svg>
                    </div>
                    <h4 class="font-headings font-bold text-deep-charcoal mb-2">Eventos y Exposiciones</h4>
                    <p class="font-sans text-xs text-slate-500">Cintas sublimadas promocionales para expositores, visitantes y staff.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Qué puedes hacer con ella / Feature Showcase -->
    <section class="py-20 bg-white px-6 overflow-hidden">
        <div class="max-w-[1280px] mx-auto">
            <div class="grid md:grid-cols-2 gap-16 items-center">
                <!-- Izquierda: Teatro CSS / Imagen Lanyards -->
                <div class="relative w-full aspect-square md:aspect-auto md:h-[600px] flex items-center justify-center p-8 overflow-visible">
                    
                    <!-- Contenedor central Lanyards -->
                    <div class="relative z-10 w-full h-full min-h-[500px] flex items-start justify-center pt-5">

                        <!-- Cinta central (Lanyard) -->
                        <div class="absolute top-0 left-1/2 -translate-x-1/2 w-8 h-40 bg-corporate-red z-10 shadow-md"></div>
                        <div class="absolute top-40 left-1/2 -translate-x-1/2 w-10 h-6 bg-slate-300 rounded-sm z-20 border border-slate-400"></div>
                        <div class="absolute top-[170px] left-1/2 -translate-x-1/2 w-4 h-8 border-2 border-slate-400 rounded-b-full z-10"></div>

                        <!-- Gafete Principal Vertical -->
                        <div class="absolute top-[195px] left-1/2 -translate-x-1/2 w-48 h-72 bg-white rounded-xl shadow-[0_25px_50px_-12px_rgba(0,0,0,0.25)] border border-slate-200 p-4 z-30 transform hover:-translate-y-2 transition-transform duration-500 cursor-pointer">
                            <div class="w-full h-24 bg-slate-100 rounded-md mb-4 flex items-center justify-center text-corporate-red">
                                <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                            </div>
                            <div class="w-full h-3 bg-slate-200 rounded mb-2"></div>
                            <div class="w-2/3 h-3 bg-slate-100 rounded mb-6"></div>
                            
                            <div class="w-full h-8 flex items-center justify-between border-t border-slate-100 pt-4">
                                <div class="w-12 h-2 bg-corporate-red/80 rounded block"></div>
                                <div class="w-8 h-8 rounded-full bg-slate-50 border border-slate-100"></div>
                            </div>
                        </div>

                        <!-- Lanyard Secundario (Izquierda fondo) -->
                        <div class="absolute top-[-20px] left-[30%] -translate-x-1/2 w-6 h-48 bg-deep-charcoal opacity-40 z-0"></div>
                        <div class="absolute top-[150px] left-[30%] -translate-x-1/2 w-6 h-6 bg-slate-300 rounded-sm z-0 opacity-40"></div>
                        <div class="absolute top-[165px] left-[30%] -translate-x-1/2 w-32 h-44 bg-slate-800 rounded-lg shadow-lg border border-slate-600 p-3 z-0 transform -rotate-6 opacity-60">
                            <div class="w-full h-16 bg-slate-700/50 rounded mb-3"></div>
                            <div class="w-full h-2 bg-slate-600 rounded mb-2"></div>
                            <div class="w-1/2 h-2 bg-slate-600 rounded"></div>
                        </div>

                        <!-- Lanyard Tercero (Derecha fondo) -->
                        <div class="absolute top-[10px] left-[70%] -translate-x-1/2 w-8 h-32 bg-slate-200 z-10 shadow-sm border border-slate-300"></div>
                        <div class="absolute top-[125px] left-[70%] -translate-x-1/2 w-40 h-56 bg-slate-100 rounded-lg shadow-xl border border-slate-300 p-4 z-20 transform rotate-12">
                            <div class="w-full h-20 bg-white rounded-md mb-3 flex items-center justify-center shadow-inner">
                                <span class="block w-6 h-6 bg-corporate-red/20 rounded-full"></span>
                            </div>
                            <div class="w-5/6 h-2 bg-slate-300 rounded mb-2"></div>
                            <div class="w-1/2 h-2 bg-slate-200 rounded"></div>
                        </div>
                    </div>
                </div>

                <!-- Derecha: Texto y Capacidades -->
                <div>
                    <div class="flex items-center gap-3 mb-4">
                        <span class="w-10 h-[2px] bg-corporate-red"></span>
                        <span class="font-headings font-bold text-xs tracking-[0.2em] text-corporate-red uppercase">Calidad Textil</span>
                    </div>
                    <h2 class="font-headings font-extrabold text-3xl md:text-5xl text-deep-charcoal mb-6 leading-tight">
                        Sujeción cómoda y <span class="text-corporate-red">segura</span>
                    </h2>
                    <p class="font-sans text-slate-500 mb-10 text-lg leading-relaxed">
                        El gafete corporativo no está terminado sin el lanyard perfecto. Manejamos cordones personalizados, lisos y herrajes metálicos de alta calidad que respetan la piel y la ropa.
                    </p>

                    <div class="space-y-6">
                        <!-- Feature 1 -->
                        <div class="flex gap-4">
                            <div class="w-12 h-12 rounded-full bg-red-50 flex items-center justify-center shrink-0 text-corporate-red">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M12 2v20"/><path d="m17 5-5-3-5 3"/><path d="m7 19 5 3 5-3"/></svg>
                            </div>
                            <div>
                                <h4 class="font-headings font-bold text-xl text-deep-charcoal mb-1">Opciones Flexibles</h4>
                                <p class="font-sans text-sm text-slate-500">Selecciona desde broches económicos tipo caimán hasta elegantes mosquetones metálicos finos que elevan tu marca.</p>
                            </div>
                        </div>
                        
                        <!-- Feature 2 -->
                        <div class="flex gap-4">
                            <div class="w-12 h-12 rounded-full bg-red-50 flex items-center justify-center shrink-0 text-corporate-red">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                            </div>
                            <div>
                                <h4 class="font-headings font-bold text-xl text-deep-charcoal mb-1">Seguridad en planta</h4>
                                <p class="font-sans text-sm text-slate-500">Implementamos broches "Safe-Break" (anti-ahorcamiento) ideales para entornos industriales y manufactureros.</p>
                            </div>
                        </div>

                        <!-- Feature 3 -->
                        <div class="flex gap-4">
                            <div class="w-12 h-12 rounded-full bg-red-50 flex items-center justify-center shrink-0 text-corporate-red">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="m16 10-4 4-4-4"/></svg>
                            </div>
                            <div>
                                <h4 class="font-headings font-bold text-xl text-deep-charcoal mb-1">Identidad de Marca</h4>
                                <p class="font-sans text-sm text-slate-500">Técnicas de impresión como sublimación full color y cuatricromía para estampar tu logo a todo lo largo del cordón.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Ecosistema Completo (Tarjetas Detalladas) -->
    <section id="catalogo" class="py-24 bg-slate-50 px-6">
        <div class="max-w-[1280px] mx-auto">
            <div class="text-center max-w-2xl mx-auto mb-16">
                <div class="flex items-center justify-center gap-3 mb-4">
                    <div class="w-12 h-[2px] bg-corporate-red"></div>
                    <span class="font-sans font-bold text-xs tracking-widest text-corporate-red uppercase">Catálogo de Accesorios</span>
                    <div class="w-12 h-[2px] bg-corporate-red"></div>
                </div>
                <h2 class="font-headings font-bold text-3xl md:text-4xl text-deep-charcoal mb-4">Todo lo que necesitas</h2>
            </div>
            
            <div class="max-w-6xl mx-auto">
                
                <!-- Encabezado Principal -->
                <div class="bg-gradient-to-br from-deep-charcoal to-[#1a1a24] rounded-3xl p-0 border border-gray-100/10 shadow-lg mb-8 flex flex-col md:flex-row overflow-hidden text-white relative">
                    <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(#fff 1px, transparent 1px); background-size: 20px 20px;"></div>
                    
                    <div class="p-8 md:p-10 md:w-3/5 relative z-10 flex flex-col justify-center">
                        <div class="flex items-center gap-3 mb-4">
                            <span class="font-sans font-bold text-xs tracking-widest text-corporate-red uppercase">Complementos In-House</span>
                        </div>
                        <h3 class="font-headings font-bold text-2xl md:text-3xl mb-4">Lanyards y Sujetadores</h3>
                        <p class="font-sans text-sm md:text-base text-slate-300 leading-relaxed max-w-lg">
                            Múltiples anchos, materiales y acabados. Contamos con inventario para envíos inmediatos de productos de línea y maquilamos sobre diseño corporativo para fortalecer la presencia de tu marca.
                        </p>
                    </div>
                    <div class="w-full md:w-2/5 min-h-[200px] bg-slate-800/50 backdrop-blur-sm border-l border-white/10 flex flex-col items-center justify-center p-6 relative z-10 overflow-hidden">
                        <!-- Gafetes colgando y balanceándose de izquierda a derecha (Solo visual sin texto) -->
                        <div class="flex gap-2 md:gap-4 relative origin-top group-hover:scale-105 transition-transform duration-500 overflow-visible h-full w-full justify-center">
                            <!-- Lanyard 1 (Rojo) -->
                            <div class="origin-top flex flex-col items-center -mt-8 animate-[swing_3.5s_ease-in-out_infinite]" style="animation-delay: 0s;">
                                <div class="w-2 md:w-2.5 h-20 bg-corporate-red shadow-sm"></div>
                                <div class="w-2.5 md:w-3 h-3 md:h-4 bg-slate-400 rounded-sm -mt-1 z-10"></div>
                                <div class="w-10 h-14 md:w-12 md:h-16 bg-white rounded-md shadow-lg border border-slate-200 flex flex-col items-center pt-2">
                                    <div class="w-4 h-4 bg-slate-200 rounded-full mb-1"></div>
                                    <div class="w-6 h-1 bg-slate-300 rounded-full mb-1"></div>
                                    <div class="w-4 h-1 bg-corporate-red/50 rounded-full"></div>
                                </div>
                            </div>
                            <!-- Lanyard 2 (Verde) -->
                            <div class="origin-top flex flex-col items-center -mt-2 animate-[swing_4.2s_ease-in-out_infinite]" style="animation-delay: 0.7s;">
                                <div class="w-2 md:w-2.5 h-24 bg-emerald-500 shadow-sm"></div>
                                <div class="w-2.5 md:w-3 h-3 md:h-4 bg-slate-400 rounded-sm -mt-1 z-10"></div>
                                <div class="w-10 h-14 md:w-12 md:h-16 bg-slate-800/90 rounded-md shadow-[0_0_15px_rgba(16,185,129,0.2)] border border-slate-600 flex flex-col items-center pt-2">
                                    <div class="w-4 h-4 bg-slate-600 rounded-full mb-1"></div>
                                    <div class="w-6 h-1 bg-emerald-400/80 rounded-full mb-1"></div>
                                    <div class="w-4 h-1 bg-slate-400 rounded-full"></div>
                                </div>
                            </div>
                            <!-- Lanyard 3 (Centro / Azul) -->
                            <div class="origin-top flex flex-col items-center -mt-6 animate-[swing_3.8s_ease-in-out_infinite]" style="animation-delay: 1.4s;">
                                <div class="w-2 md:w-2.5 h-28 bg-blue-500 shadow-sm"></div>
                                <div class="w-2.5 md:w-3 h-3 md:h-4 bg-slate-400 rounded-sm -mt-1 z-10"></div>
                                <div class="w-10 h-14 md:w-12 md:h-16 bg-white rounded-md shadow-lg border border-slate-200 flex flex-col items-center pt-2">
                                    <div class="w-4 h-4 bg-slate-200 rounded-full mb-1"></div>
                                    <div class="w-6 h-1 bg-slate-300 rounded-full mb-1"></div>
                                    <div class="w-4 h-1 bg-blue-500/50 rounded-full"></div>
                                </div>
                            </div>
                            <!-- Lanyard 4 (Amarillo) -->
                            <div class="origin-top flex flex-col items-center -mt-10 animate-[swing_4.5s_ease-in-out_infinite]" style="animation-delay: 0.3s;">
                                <div class="w-2 md:w-2.5 h-16 bg-amber-400 shadow-sm"></div>
                                <div class="w-2.5 md:w-3 h-3 md:h-4 bg-slate-400 rounded-sm -mt-1 z-10"></div>
                                <div class="w-10 h-14 md:w-12 md:h-16 bg-slate-800/90 rounded-md shadow-[0_0_15px_rgba(251,191,36,0.2)] border border-slate-600 flex flex-col items-center pt-2">
                                    <div class="w-4 h-4 bg-slate-600 rounded-full mb-1"></div>
                                    <div class="w-6 h-1 bg-amber-400/80 rounded-full mb-1"></div>
                                    <div class="w-4 h-1 bg-slate-400 rounded-full"></div>
                                </div>
                            </div>
                            <!-- Lanyard 5 (Morado) -->
