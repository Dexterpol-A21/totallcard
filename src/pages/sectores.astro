---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
    title="Sectores y Aplicaciones de Credenciales PVC | TOTALLCARD"
    description="Implementamos tarjetas para cada industria: compatibilidad con Soft Restaurant, credenciales para educación, gafetes de salud, corporativos y tarjetas de lealtad retail."
    keywords="credenciales para restaurantes, soft restaurant tarjetas, gafetes hospitales, tarjetas de lealtad, credenciales escuelas, membresías clubes, gafetes corporativos"
>
    <Header submenu="empresa" active="SECTORES ATENDIDOS" />

    <!-- Hero Section Minimalista -->
    <section class="relative pt-8 pb-8 md:pt-48 md:pb-12 bg-white overflow-hidden">
        <div class="max-w-[1400px] mx-auto px-6 relative z-10">
            
            <div class="flex flex-col lg:flex-row lg:justify-between lg:items-start gap-8 lg:gap-16 mb-8 pt-6">
                <!-- Letras Gigantes (Izquierda) -->
                <h1 class="font-headings font-black text-[5.5rem] sm:text-[8rem] md:text-[11rem] lg:text-[12rem] text-black leading-[0.75] tracking-tighter uppercase shrink-0">
                    NUESTROS<br/>
                    <span class="text-corporate-red">SECTORES.</span>
                </h1>

                <!-- Eslogan (Derecha Gigante) -->
                <div class="lg:w-full lg:mt-4 flex lg:justify-end items-center">
                    <p class="font-headings text-black font-black text-4xl sm:text-6xl lg:text-[4.5rem] xl:text-[5.5rem] tracking-tighter uppercase leading-[0.85] lg:text-right border-l-8 lg:border-l-0 lg:border-r-[16px] border-corporate-red pl-6 lg:pl-0 lg:pr-8">
                        TARJETAS<br/>PARA CADA<br/>
                        <span class="text-corporate-red">INDUSTRIA.</span>
                    </p>
                </div>
            </div>

            <!-- Contenido Inferior -->
            <div class="mt-8">
                <!-- Texto descriptivo -->
                <div class="max-w-3xl">
                    <p class="font-headings font-bold text-xl md:text-3xl text-black leading-snug mb-6 border-l-8 border-corporate-red pl-6">
                        SOLUCIONES A LA MEDIDA DE TUS NECESIDADES.
                    </p>
                    <p class="font-sans text-black/70 text-lg md:text-xl mb-4 pl-8">
                        Integramos tecnología de identificación en diferentes mercados para garantizar accesos seguros, control eficiente y lealtad entre tus miembros.
                    </p>
                </div>
            </div>
            
        </div>
    </section>

    <!-- Sectores Grid Section -->
    <section class="py-10 md:py-16 bg-slate-50 px-6 border-t border-b border-light-gray/40">
        <div class="max-w-[1280px] mx-auto">
            <div class="mb-12 text-center md:text-left">
                <div class="flex items-center justify-center md:justify-start gap-3 mb-3">
                    <div class="w-12 h-[2px] bg-corporate-red"></div>
                    <span class="font-sans font-bold text-xs tracking-widest text-corporate-red uppercase">Aplicaciones</span>
                </div>
                <h2 class="font-headings font-bold text-3xl md:text-4xl text-deep-charcoal mb-4">Sectores a los que servimos</h2>
            </div>
            
            <div class="flex flex-col gap-8">
                <!-- Sector Restaurantes -->
                <div class="bg-orange-500 group pvc-card w-full has-punch deal-ready rounded-[1rem] hover:border-black p-8 md:p-12 shadow-md hover:shadow-xl transition-all duration-300 flex flex-col md:flex-row items-start md:items-center gap-6 md:gap-12 relative overflow-hidden lg:max-w-none">
                    <div class="w-16 h-16 md:w-24 md:h-24 bg-white flex items-center justify-center shrink-0 border border-orange-400 group-hover:border-black transition-colors">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 md:w-14 md:h-14 text-orange-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2"/><path d="M7 2v20"/><path d="M21 15V2a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7"/></svg>
                    </div>
                    <div class="flex-1">
                        <h3 class="font-headings font-black text-3xl md:text-5xl text-white uppercase tracking-tighter mb-4">Restaurantes</h3>
                        <p class="font-sans text-lg text-white/90 leading-relaxed max-w-3xl">
                            Tarjetas de cliente frecuente, monederos electrónicos, tarjetas de regalo y control de personal. Perfecta integración con sistemas como Soft Restaurant.
                        </p>
                    </div>
                    <div class="w-full md:w-auto shrink-0 flex flex-wrap md:flex-col gap-2 mt-4 md:mt-0 justify-end md:items-end">
                        <span class="px-4 py-2 bg-orange-700 text-white font-bold text-xs tracking-widest uppercase">Soft Restaurant</span>
                        <span class="px-4 py-2 bg-orange-700 text-white font-bold text-xs tracking-widest uppercase">Monederos</span>
                        <span class="px-4 py-2 bg-orange-700 text-white font-bold text-xs tracking-widest uppercase">Lealtad</span>
                    </div>
                </div>

                <!-- Sector 1 -->
                <div class="bg-white group pvc-card w-full has-punch deal-ready rounded-[1rem] border border-slate-200 hover:border-corporate-red hover:-translate-y-1 p-8 md:p-12 shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col md:flex-row items-start md:items-center gap-6 md:gap-12 relative overflow-hidden lg:max-w-none">
                    <div class="w-16 h-16 md:w-24 md:h-24 bg-slate-50 flex items-center justify-center shrink-0 border border-slate-100 group-hover:border-corporate-red transition-colors">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 md:w-14 md:h-14 text-corporate-red" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>
                    </div>
                    <div class="flex-1">
                        <h3 class="font-headings font-black text-3xl md:text-5xl text-black uppercase tracking-tighter mb-4">Educación</h3>
                        <p class="font-sans text-lg text-slate-600 leading-relaxed max-w-3xl">
                            Credenciales para estudiantes, personal docente y control de acceso en escuelas y universidades.
                        </p>
                    </div>
                    <div class="w-full md:w-auto shrink-0 flex flex-wrap md:flex-col gap-2 mt-4 md:mt-0 justify-end md:items-end">
                        <span class="px-4 py-2 bg-slate-100 text-corporate-red font-bold text-xs tracking-widest uppercase">Estudiantes</span>
                        <span class="px-4 py-2 bg-slate-100 text-corporate-red font-bold text-xs tracking-widest uppercase">Docentes</span>
                        <span class="px-4 py-2 bg-slate-100 text-corporate-red font-bold text-xs tracking-widest uppercase">Accesos</span>
                    </div>
                </div>

                <!-- Sector 2 -->
                <div class="bg-white group pvc-card w-full has-punch deal-ready rounded-[1rem] border border-slate-200 hover:border-corporate-red hover:-translate-y-1 p-8 md:p-12 shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col md:flex-row items-start md:items-center gap-6 md:gap-12 relative overflow-hidden lg:max-w-none">
                    <div class="w-16 h-16 md:w-24 md:h-24 bg-slate-50 flex items-center justify-center shrink-0 border border-slate-100 group-hover:border-corporate-red transition-colors">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 md:w-14 md:h-14 text-corporate-red" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect width="16" height="20" x="4" y="2" rx="2" ry="2"/><path d="M9 22v-4h6v4"/><path d="M8 6h.01"/><path d="M16 6h.01"/><path d="M12 6h.01"/><path d="M12 10h.01"/><path d="M12 14h.01"/><path d="M16 10h.01"/><path d="M16 14h.01"/><path d="M8 10h.01"/><path d="M8 14h.01"/></svg>
                    </div>
                    <div class="flex-1">
                        <h3 class="font-headings font-black text-3xl md:text-5xl text-black uppercase tracking-tighter mb-4">Corporativo</h3>
                        <p class="font-sans text-lg text-slate-600 leading-relaxed max-w-3xl">
                            Identificaciones para empleados y visitantes, con integración para control de accesos en oficinas y corporativos.
                        </p>
                    </div>
                    <div class="w-full md:w-auto shrink-0 flex flex-wrap md:flex-col gap-2 mt-4 md:mt-0 justify-end md:items-end">
                        <span class="px-4 py-2 bg-slate-100 text-corporate-red font-bold text-xs tracking-widest uppercase">Empleados</span>
                        <span class="px-4 py-2 bg-slate-100 text-corporate-red font-bold text-xs tracking-widest uppercase">Visitantes</span>
                        <span class="px-4 py-2 bg-slate-100 text-corporate-red font-bold text-xs tracking-widest uppercase">Torniquetes</span>
                    </div>
                </div>

                <!-- Sector 3 -->
                <div class="bg-white group pvc-card w-full has-punch deal-ready rounded-[1rem] border border-slate-200 hover:border-corporate-red hover:-translate-y-1 p-8 md:p-12 shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col md:flex-row items-start md:items-center gap-6 md:gap-12 relative overflow-hidden lg:max-w-none">
                    <div class="w-16 h-16 md:w-24 md:h-24 bg-slate-50 flex items-center justify-center shrink-0 border border-slate-100 group-hover:border-corporate-red transition-colors">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 md:w-14 md:h-14 text-corporate-red" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
                    </div>
                    <div class="flex-1">
                        <h3 class="font-headings font-black text-3xl md:text-5xl text-black uppercase tracking-tighter mb-4">Salud</h3>
                        <p class="font-sans text-lg text-slate-600 leading-relaxed max-w-3xl">
                            Gafetes para personal médico, enfermería, administradores y pases de visitantes en hospitales y clínicas.
                        </p>
                    </div>
                    <div class="w-full md:w-auto shrink-0 flex flex-wrap md:flex-col gap-2 mt-4 md:mt-0 justify-end md:items-end">
                        <span class="px-4 py-2 bg-slate-100 text-corporate-red font-bold text-xs tracking-widest uppercase">Médicos</span>
                        <span class="px-4 py-2 bg-slate-100 text-corporate-red font-bold text-xs tracking-widest uppercase">Enfermería</span>
                        <span class="px-4 py-2 bg-slate-100 text-corporate-red font-bold text-xs tracking-widest uppercase">Pacientes</span>
                    </div>
                </div>

                <!-- Sector 4 -->
                <div class="bg-white group pvc-card w-full has-punch deal-ready rounded-[1rem] border border-slate-200 hover:border-corporate-red hover:-translate-y-1 p-8 md:p-12 shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col md:flex-row items-start md:items-center gap-6 md:gap-12 relative overflow-hidden lg:max-w-none">
                    <div class="w-16 h-16 md:w-24 md:h-24 bg-slate-50 flex items-center justify-center shrink-0 border border-slate-100 group-hover:border-corporate-red transition-colors">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 md:w-14 md:h-14 text-corporate-red" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                    </div>
                    <div class="flex-1">
                        <h3 class="font-headings font-black text-3xl md:text-5xl text-black uppercase tracking-tighter mb-4">Retail y Cadenas</h3>
                        <p class="font-sans text-lg text-slate-600 leading-relaxed max-w-3xl">
                            Tarjetas de lealtad, monederos electrónicos y tarjetas de regalo para programas de clientes frecuentes.
                        </p>
                    </div>
                    <div class="w-full md:w-auto shrink-0 flex flex-wrap md:flex-col gap-2 mt-4 md:mt-0 justify-end md:items-end">
                        <span class="px-4 py-2 bg-slate-100 text-corporate-red font-bold text-xs tracking-widest uppercase">Fidelidad</span>
                        <span class="px-4 py-2 bg-slate-100 text-corporate-red font-bold text-xs tracking-widest uppercase">Gift Cards</span>
                        <span class="px-4 py-2 bg-slate-100 text-corporate-red font-bold text-xs tracking-widest uppercase">Puntos</span>
                    </div>
                </div>

                <!-- Sector 5 -->
                <div class="bg-white group pvc-card w-full has-punch deal-ready rounded-[1rem] border border-slate-200 hover:border-corporate-red hover:-translate-y-1 p-8 md:p-12 shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col md:flex-row items-start md:items-center gap-6 md:gap-12 relative overflow-hidden lg:max-w-none">
                    <div class="w-16 h-16 md:w-24 md:h-24 bg-slate-50 flex items-center justify-center shrink-0 border border-slate-100 group-hover:border-corporate-red transition-colors">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 md:w-14 md:h-14 text-corporate-red" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><path d="M7 7h10"/><path d="M7 12h10"/><path d="M7 17h10"/></svg>
                    </div>
                    <div class="flex-1">
                        <h3 class="font-headings font-black text-3xl md:text-5xl text-black uppercase tracking-tighter mb-4">Asociaciones y Clubes</h3>
                        <p class="font-sans text-lg text-slate-600 leading-relaxed max-w-3xl">
                            Membresías exclusivas para clubes deportivos, gimnasios, cajas de ahorro y organizaciones privadas.
                        </p>
                    </div>
                    <div class="w-full md:w-auto shrink-0 flex flex-wrap md:flex-col gap-2 mt-4 md:mt-0 justify-end md:items-end">
                        <span class="px-4 py-2 bg-slate-100 text-corporate-red font-bold text-xs tracking-widest uppercase">Membresías</span>
                        <span class="px-4 py-2 bg-slate-100 text-corporate-red font-bold text-xs tracking-widest uppercase">Gimnasios</span>
                        <span class="px-4 py-2 bg-slate-100 text-corporate-red font-bold text-xs tracking-widest uppercase">Socios</span>
                    </div>
                </div>

                <!-- Sector 6 -->
                <div class="bg-white group pvc-card w-full has-punch deal-ready rounded-[1rem] border border-slate-200 hover:border-corporate-red hover:-translate-y-1 p-8 md:p-12 shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col md:flex-row items-start md:items-center gap-6 md:gap-12 relative overflow-hidden lg:max-w-none">
                    <div class="w-16 h-16 md:w-24 md:h-24 bg-slate-50 flex items-center justify-center shrink-0 border border-slate-100 group-hover:border-corporate-red transition-colors">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 md:w-14 md:h-14 text-corporate-red" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                    </div>
                    <div class="flex-1">
                        <h3 class="font-headings font-black text-3xl md:text-5xl text-black uppercase tracking-tighter mb-4">Gobierno y Seguridad</h3>
                        <p class="font-sans text-lg text-slate-600 leading-relaxed max-w-3xl">
                            Identificaciones oficiales con altos estándares de seguridad para dependencias estatales y de gobierno.
                        </p>
                    </div>
                    <div class="w-full md:w-auto shrink-0 flex flex-wrap md:flex-col gap-2 mt-4 md:mt-0 justify-end md:items-end">
                        <span class="px-4 py-2 bg-slate-100 text-corporate-red font-bold text-xs tracking-widest uppercase">Alta Seguridad</span>
                        <span class="px-4 py-2 bg-slate-100 text-corporate-red font-bold text-xs tracking-widest uppercase">ID Oficial</span>
                        <span class="px-4 py-2 bg-slate-100 text-corporate-red font-bold text-xs tracking-widest uppercase">Dependencias</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Call To Action (Banner Final) -->
    <section class="py-12 md:py-16 bg-corporate-red px-6 relative overflow-hidden">
        <!-- SVG Decoración (Efecto Ondas) -->
        <div class="absolute inset-0 mix-blend-overlay opacity-20 pointer-events-none">
            <svg viewBox="0 0 100 100" preserveAspectRatio="none" class="w-full h-full text-white" fill="currentColor">
                <path d="M0,0 C30,30 70,-10 100,50 L100,100 L0,100 Z" opacity="0.3"></path>
                <path d="M0,50 C40,-10 60,60 100,20 L100,100 L0,100 Z"></path>
            </svg>
        </div>

        <div class="max-w-[1280px] mx-auto relative z-10 flex flex-col md:flex-row items-center justify-between gap-8 text-center md:text-left">
            <div>
                <h2 class="font-headings font-bold text-3xl md:text-4xl text-white mb-3">¿Tu industria no está aquí?</h2>
                <p class="font-sans text-white/80 text-sm md:text-base max-w-lg">Nos adaptamos a cualquier necesidad de credencialización o fidelización. Contáctanos y armemos el proyecto que buscas.</p>
            </div>
            <div class="shrink-0">
                <a href="https://wa.me/525615429492" class="inline-block bg-white text-corporate-red font-sans font-bold text-sm tracking-wider uppercase px-8 py-4 rounded-full transition-transform hover:-translate-y-1 hover:shadow-lg">
                    Contactar a un Asesor
                </a>
            </div>
        </div>
    </section>

    <Footer />
</Layout>