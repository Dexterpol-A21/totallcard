---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Lanyard from '../components/Lanyard.jsx';
import Footer from '../components/Footer.astro';
---

<Layout 
	title="Tarjetas de Proximidad RFID y NFC (Control de Acceso) | TOTALLCARD" 
	description="Tarjetas RFID y NFC de proximidad (Mifare 13.56 MHz, 125 kHz) para control de acceso, asistencia y cerraduras de hotel. Tecnología y seguridad en PVC duradero."
	keywords="tarjetas RFID, tarjetas de proximidad, tarjetas NFC, credenciales inteligentes, llaves de hotel, control de acceso RFID, Mifare, EM4100"
>
	<div class="hidden lg:flex fixed inset-0 z-[100] pointer-events-none w-screen h-screen">
		<Lanyard client:only="react" position={[0, 0, 45]} gravity={[0, -40, 0]} />
	</div>
	<Header submenu="tarjetas" active="TARJETAS RFID / NFC" />

	<!-- Hero Section: Gafetes Empresariales -->
	<section class="lg:min-h-[85vh] flex items-start lg:items-center pt-8 pb-8 lg:pt-40 md:pb-12 px-6 bg-white overflow-hidden relative">
		<div class="max-w-[1280px] mx-auto grid md:grid-cols-2 gap-8 items-center w-full">
			<div class="z-10">
				<p class="font-headings text-corporate-red font-bold text-xs md:text-sm tracking-widest uppercase mb-4">
					Control de Acceso Inteligente.
				</p>
				<h1 class="font-headings font-extrabold text-4xl md:text-5xl lg:text-6xl text-deep-charcoal leading-[1.1] mb-6">
							Tarjetas RFID / Proximidad
						</h1>
				<p class="font-sans text-base md:text-lg text-medium-gray mb-6 max-w-xl">
					Identificación profesional, segura y con estilo para los colaboradores de tu empresa. Refuerza la identidad corporativa y asegura tus instalaciones.
				</p>
				
				<div class="hidden md:flex flex-col sm:flex-row gap-6 mb-6 items-center">
					<a href="https://wa.me/525615429492" class="download-button inline-flex">
						<div class="docs py-3 px-6">
							<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21l1.65-3.8a9 9 0 1 1 3.4 2.9L3 21" /><path d="M9 10a.5.5 0 0 0 1 0V9a.5.5 0 0 0-1 0v1a5 5 0 0 0 5 5h1a.5.5 0 0 0 0-1h-1a.5.5 0 0 0 0 1" /></svg>
							<span class="font-bold text-[15px] tracking-wider uppercase">COTIZACIÓN POR WHATSAPP</span>
						</div>
						<div class="download">
							<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/></svg>
						</div>
					</a>
				</div>
                
                <div class="flex flex-row flex-nowrap justify-between md:justify-start gap-2 sm:gap-4 md:gap-8 pt-2 w-full">
                    <div class="flex flex-col md:flex-row items-center gap-2 md:gap-4 w-1/3 md:w-auto text-center md:text-left">
                        <div class="w-10 h-10 md:w-12 md:h-12 rounded bg-light-gray/40 flex items-center justify-center shrink-0">
                            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-corporate-red w-5 h-5 md:w-6 md:h-6"><rect x="3" y="4" width="18" height="16" rx="2" ry="2"></rect><line x1="8" y1="2" x2="8" y2="6"></line><line x1="16" y1="2" x2="16" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                        </div>
                        <span class="font-headings font-bold text-[9px] md:text-xs uppercase tracking-widest text-deep-charcoal leading-snug">Impresión<br />HD</span>
                    </div>
                    <div class="flex flex-col md:flex-row items-center gap-2 md:gap-4 w-1/3 md:w-auto text-center md:text-left">
                        <div class="w-10 h-10 md:w-12 md:h-12 rounded bg-light-gray/40 flex items-center justify-center shrink-0">
                            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-corporate-red w-5 h-5 md:w-6 md:h-6"><path d="M4 11a9 9 0 0 1 9 9"></path><path d="M4 4a16 16 0 0 1 16 16"></path><circle cx="5" cy="19" r="1"></circle></svg>
                        </div>
                        <span class="font-headings font-bold text-[9px] md:text-xs uppercase tracking-widest text-deep-charcoal leading-snug">Tecnología<br />RFID / NFC</span>
                    </div>
                    <div class="flex flex-col md:flex-row items-center gap-2 md:gap-4 w-1/3 md:w-auto text-center md:text-left">
                        <div class="w-10 h-10 md:w-12 md:h-12 rounded bg-light-gray/40 flex items-center justify-center shrink-0">
                            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-corporate-red w-5 h-5 md:w-6 md:h-6"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
                        </div>
                        <span class="font-headings font-bold text-[9px] md:text-xs uppercase tracking-widest text-deep-charcoal leading-snug">Alta<br />Durabilidad</span>
                    </div>
                </div>
			</div>
			
			<div class="relative w-full h-[350px] md:h-[500px]">
                <div class="w-full h-[300px] md:h-full relative z-10 pointer-events-none select-none">
                    <picture class="contents">
    <source srcset="/images/rfid.avif" type="image/avif" />
    <source srcset="/images/rfid.webp" type="image/webp" />
    <img draggable="false" src="/images/rfid.webp" alt="Tarjetas RFID" class="w-full h-full object-cover relative z-10 rounded-[2rem] shadow-2xl border-[8px] border-white pointer-events-none select-none" loading="lazy" decoding="async" />
</picture>
                </div>

                <div class="flex md:hidden flex-col sm:flex-row gap-6 mt-4 pb-2 items-center w-full justify-center relative z-50">
                    <a href="https://wa.me/525615429492" class="download-button inline-flex">
                        <div class="docs py-3 px-6">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21l1.65-3.8a9 9 0 1 1 3.4 2.9L3 21" /><path d="M9 10a.5.5 0 0 0 1 0V9a.5.5 0 0 0-1 0v1a5 5 0 0 0 5 5h1a.5.5 0 0 0 0-1h-1a.5.5 0 0 0 0 1" /></svg>
                            <span class="font-bold text-[15px] tracking-wider uppercase">COTIZACIÓN</span>
                        </div>
                        <div class="download">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/></svg>
                        </div>
                    </a>
                </div>
</div>
		</div>
	</section>

        <!-- Aplicaciones / A quién va dirigido -->
        <section class="py-10 md:py-12 px-6 bg-slate-50 border-b border-light-gray/40">
            <div class="max-w-[1280px] mx-auto">
                <div class="text-center max-w-2xl mx-auto mb-12">
                    <div class="flex items-center justify-center gap-3 mb-3">
                        <div class="w-12 h-[2px] bg-corporate-red"></div>
                        <span class="font-sans font-bold text-xs tracking-widest text-corporate-red uppercase">Aplicaciones</span>
                    </div>
                    <h2 class="font-headings font-bold text-3xl md:text-4xl text-deep-charcoal mb-4">Usos de nuestras Tarjetas RFID</h2>
                    <p class="font-sans text-medium-gray">Control y automatización para cualquier área que requiera seguridad e ingresos monitoreados.</p>
                </div>
                
                <div id="aplicaciones-container" class="flex overflow-x-auto snap-x snap-mandatory gap-6 pb-6 px-4 md:px-0 [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden md:grid md:grid-cols-4 md:overflow-visible relative">
                    <!-- Sector 1 -->
                    <div class="bg-white min-w-[280px] w-[85vw] snap-center shrink-0 md:min-w-0 md:w-auto rounded-2xl p-8 hover:-translate-y-1 transition-transform border border-slate-100 flex flex-col items-center text-center shadow-sm">
                        <div class="w-16 h-16 bg-slate-50 rounded-full flex items-center justify-center mb-4 text-corporate-red">
                            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M4 2v20l-2-2"/><path d="M20 2v20l2-2"/><path d="M15 6h2"/><path d="M15 10h2"/><path d="M15 14h2"/><path d="M15 18h2"/><path d="M7 6h2"/><path d="M7 10h2"/><path d="M7 14h2"/><path d="M7 18h2"/></svg>
                        </div>
                        <h4 class="font-headings font-bold text-deep-charcoal mb-2">Oficinas y Corporativos</h4>
                        <p class="font-sans text-xs text-slate-500">Control de acceso seguro para empleados en corporativos.</p>
                    </div>
                    <!-- Sector 2 -->
                    <div class="bg-white min-w-[280px] w-[85vw] snap-center shrink-0 md:min-w-0 md:w-auto rounded-2xl p-8 hover:-translate-y-1 transition-transform border border-slate-100 flex flex-col items-center text-center shadow-sm">
                        <div class="w-16 h-16 bg-slate-50 rounded-full flex items-center justify-center mb-4 text-corporate-red">
                            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.4 2.9A3.7 3.7 0 0 0 2 12v4c0 .6.4 1 1 1h2"/><circle cx="7" cy="17" r="2"/><path d="M9 17h6"/><circle cx="17" cy="17" r="2"/></svg>
                        </div>
                        <h4 class="font-headings font-bold text-deep-charcoal mb-2">Estacionamientos</h4>
                        <p class="font-sans text-xs text-slate-500">Acceso automatizado al aproximar la tarjeta a la pluma.</p>
                    </div>
                    <!-- Sector 3 -->
                    <div class="bg-white min-w-[280px] w-[85vw] snap-center shrink-0 md:min-w-0 md:w-auto rounded-2xl p-8 hover:-translate-y-1 transition-transform border border-slate-100 flex flex-col items-center text-center shadow-sm">
                        <div class="w-16 h-16 bg-slate-50 rounded-full flex items-center justify-center mb-4 text-corporate-red">
                            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M2 4v16"/><path d="M2 8h18a2 2 0 0 1 2 2v10"/><path d="M2 17h20"/><path d="M6 8v9"/></svg>
                        </div>
                        <h4 class="font-headings font-bold text-deep-charcoal mb-2">Hoteles</h4>
                        <p class="font-sans text-xs text-slate-500">Llaves electrónicas para habitaciones.</p>
                    </div>
                    <!-- Sector 4 -->
                    <div class="bg-white min-w-[280px] w-[85vw] snap-center shrink-0 md:min-w-0 md:w-auto rounded-2xl p-8 hover:-translate-y-1 transition-transform border border-slate-100 flex flex-col items-center text-center shadow-sm">
                        <div class="w-16 h-16 bg-slate-50 rounded-full flex items-center justify-center mb-4 text-corporate-red">
                            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M14.4 14.4 9.6 9.6"/><path d="M18.657 21.485a2 2 0 1 1-2.829-2.828l-1.767 1.768a2 2 0 1 1-2.829-2.829l6.364-6.364a2 2 0 1 1 2.829 2.829l-1.768 1.767a2 2 0 1 1 2.828 2.829z"/><path d="m21.5 21.5-1.4-1.4"/><path d="M3.9 3.9 2.5 2.5"/><path d="M6.404 7.172a2 2 0 1 1-2.829-2.829l1.768-1.767a2 2 0 1 1 2.829-2.829l6.364 6.364a2 2 0 1 1-2.829 2.829l1.767 1.768a2 2 0 1 1-2.828 2.829z"/></svg>
                        </div>
                        <h4 class="font-headings font-bold text-deep-charcoal mb-2">Gimnasios y Hospitales</h4>
                        <p class="font-sans text-xs text-slate-500">Uso de casilleros y equipos restringidos.</p>
                    </div>
                </div>

                <!-- Controles de Galería (Solo Móviles) -->
                <div id="aplicaciones-dots" class="flex md:hidden justify-center gap-2 mt-2 pb-4">
                    <button aria-label="Ir a sector 1" class="w-4 h-2.5 rounded-full bg-corporate-red transition-all duration-300"></button>
                    <button aria-label="Ir a sector 2" class="w-2.5 h-2.5 rounded-full bg-slate-300 transition-all duration-300"></button>
                    <button aria-label="Ir a sector 3" class="w-2.5 h-2.5 rounded-full bg-slate-300 transition-all duration-300"></button>
                    <button aria-label="Ir a sector 4" class="w-2.5 h-2.5 rounded-full bg-slate-300 transition-all duration-300"></button>
                </div>
            </div>
        </section>

	<!-- Diagrama / Infografía de Credencial -->
        <section class="py-10 md:py-12 px-6 bg-white relative overflow-hidden border-b border-light-gray/40">
        <div class="max-w-[1280px] mx-auto text-center mb-16 relative z-10">
            <h2 class="font-headings font-bold text-3xl md:text-4xl text-deep-charcoal mb-4">Anatomía de una Tarjeta Inteligente RFID</h2>
            <p class="font-sans text-medium-gray max-w-2xl mx-auto">Inteligencia invisible. Descubre cómo los chips internos y antenas aseguran un acceso rápido, seguro y sin contacto.</p>
        </div>

        <div class="max-w-[1000px] mx-auto relative flex flex-col items-center justify-center min-h-[500px] lg:min-h-[550px] z-10">
            
            <!-- TARJETA CENTRAL -->
            <div class="pvc-card z-30 transform hover:scale-105 transition-transform duration-500 deal-ready group transition-all duration-700 hover:-translate-y-3 hover:shadow-[0_20px_40px_rgba(0,0,0,0.4)] hover:-rotate-1 relative flex flex-col w-full aspect-[86/54] lg:max-w-[400px] mx-auto bg-gradient-to-tr from-[#1e3a8a] to-[#2563eb] rounded-[14px] overflow-hidden shadow-xl border border-blue-900" >
                    <!-- Reflejo brillante diagonal típico de PVC full-color -->
                    <div class="absolute -inset-[100%] bg-gradient-to-tr from-transparent via-white/10 to-transparent opacity-0 group-hover:opacity-100 group-hover:translate-x-1/2 transition-all duration-1000 rotate-45 z-30 pointer-events-none"></div>
                    
                    <!-- Elemento decorativo ondas RFID -->
                    <div class="absolute -right-4 top-1/2 -translate-y-1/2 flex items-center justify-center opacity-10">
                        <div class="w-32 h-32 rounded-full border-4 border-white"></div>
                        <div class="absolute w-48 h-48 rounded-full border-4 border-white"></div>
                        <div class="absolute w-64 h-64 rounded-full border-4 border-white"></div>
                    </div>

                    <div class="p-5 sm:p-6 flex flex-col h-full relative z-20">
                        <!-- Top Section -->
                        <div class="flex justify-between items-start mb-2">
                            <div class="flex items-center space-x-2">
                                <div class="w-8 h-8 rounded-full bg-white/10 flex items-center justify-center border border-white/20 backdrop-blur-sm">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 8.32a7.43 7.43 0 0 1 0 7.36"/><path d="M9.5 6.69a11.29 11.29 0 0 1 0 10.62"/><path d="M13 5.07a15.22 15.22 0 0 1 0 13.86"/><path d="M16.5 3.44a19.13 19.13 0 0 1 0 17.12"/></svg>
                                </div>
                                <span class="text-white/80 font-sans text-[8px] sm:text-[9px] tracking-[0.2em] uppercase border border-white/20 px-2 py-0.5 rounded-full z-10 relative bg-black/10">NFC / RFID</span>
                            </div>
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="url(#rfid-grad)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="opacity-50">
                                <defs><linearGradient id="rfid-grad" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" stop-color="#fff"/><stop offset="100%" stop-color="#93c5fd"/></linearGradient></defs>
                                <path d="M11 20a3 3 0 0 1 -3 -3v-11l5 5" />
                                <path d="M13 4a3 3 0 0 1 3 3v11l-5 -5" />
                                <rect x="4" y="4" width="16" height="16" rx="3" />
                            </svg>
                        </div>

                        <!-- Mid Section: Textos Integrados en el Diseño -->
                        <div class="my-auto flex flex-col pt-3 relative z-10">
                            <h3 class="text-white font-headings font-bold text-sm sm:text-base md:text-lg leading-tight mb-1">Tarjetas RFID / NFC</h3>
                            <p class="text-blue-100/90 font-sans text-[10px] sm:text-[11px] leading-snug w-[80%] max-w-[220px]">Tecnología avanzada para control de acceso, pagos y seguimiento inteligente sin contacto.</p>
                        </div>

                        <!-- Bottom Section: Simulación de antena/chip interno -->
                        <div class="mt-auto flex justify-between items-end border-t border-white/10 pt-3">
                            <div class="text-white/40 font-sans text-[7px] sm:text-[8px] tracking-widest uppercase font-mono">
                                ISO/IEC 14443 TIPO A
                            </div>
                            <!-- "Antena" expuesta de forma decorativa -->
                            <div class="flex items-center space-x-1 opacity-40">
                                <div class="w-1 h-3 border border-white rounded-sm"></div>
                                <div class="w-1 h-4 border border-white rounded-sm"></div>
                                <div class="w-1 h-5 border border-white rounded-sm bg-white"></div>
                                <div class="w-1 h-4 border border-white rounded-sm"></div>
                                <div class="w-1 h-3 border border-white rounded-sm"></div>
                            </div>
                        </div>
                    </div>
                </div>

            <!-- ANOTACIONES Y LÍNEAS (Desktop/LG) -->
            <div class="hidden lg:block absolute inset-0 pointer-events-none z-20">
                
                <!-- Apunte 1: Perforación (Arriba Izquierda) -->
                <div class="absolute top-[20%] left-[-15%] text-right w-[320px]">
                    <div class="bg-white p-4 rounded-xl shadow-lg border border-slate-100 inline-block pointer-events-auto hover:-translate-y-1 transition-transform">
                        <div class="flex items-center gap-2 mb-1 justify-end">
                            <h4 class="font-headings font-bold text-deep-charcoal">Antena Invisible</h4>
                            <div class="w-2 h-2 rounded-full bg-corporate-red"></div>
                        </div>
                        <p class="font-sans text-xs text-slate-500">Chip interior (Mifare o Proximity) completamente oculto.</p>
                    </div>
                    <!-- Línea SVG -->
                    <svg class="absolute top-1/2 left-[100%] ml-2 w-[110px] h-[60px] overflow-visible" style="transform: translateY(-50%)">
                        <path d="M0,30 Q55,30 110,60" fill="none" stroke="#cbd5e1" stroke-width="2" stroke-dasharray="4,4" />
                        <circle cx="110" cy="60" r="4" fill="#e1061a" />
                    </svg>
                </div>

                <!-- Apunte 2: Diseño Institucional (Centro Derecha) -->
                <div class="absolute top-[35%] right-[-15%] text-left w-[320px]">
                    <div class="bg-white p-4 rounded-xl shadow-lg border border-slate-100 inline-block pointer-events-auto hover:-translate-y-1 transition-transform">
                        <div class="flex items-center gap-2 mb-1 justify-start">
                            <div class="w-2 h-2 rounded-full bg-corporate-red"></div>
                            <h4 class="font-headings font-bold text-deep-charcoal">Impresión Edge-to-Edge</h4>
                        </div>
                        <p class="font-sans text-xs text-slate-500">Gráficos a todo color que cubren el 100% de la superficie inteligente.</p>
                    </div>
                    <!-- Línea SVG -->
                    <svg class="absolute top-1/2 right-[100%] mr-2 w-[110px] h-[40px] overflow-visible" style="transform: translateY(-50%)">
                        <path d="M110,20 Q55,20 0,60" fill="none" stroke="#cbd5e1" stroke-width="2" stroke-dasharray="4,4" />
                        <circle cx="0" cy="60" r="4" fill="#e1061a" />
                    </svg>
                </div>

                <!-- Apunte 3: Foto (Centro Izquierda) -->
                <div class="absolute top-[60%] left-[-15%] text-right w-[320px]">
                    <div class="bg-white p-4 rounded-xl shadow-lg border border-slate-100 inline-block pointer-events-auto hover:-translate-y-1 transition-transform">
                        <div class="flex items-center gap-2 mb-1 justify-end">
                            <h4 class="font-headings font-bold text-deep-charcoal">Folio Consecutivo</h4>
                            <div class="w-2 h-2 rounded-full bg-corporate-red"></div>
                        </div>
                        <p class="font-sans text-xs text-slate-500">Numeración física grabada como respaldo de la información digital.</p>
                    </div>
                    <!-- Línea SVG -->
                    <svg class="absolute top-1/2 left-[100%] ml-2 w-[110px] h-[20px] overflow-visible" style="transform: translateY(-50%)">
                        <path d="M0,10 L110,10" fill="none" stroke="#cbd5e1" stroke-width="2" stroke-dasharray="4,4" />
                        <circle cx="110" cy="10" r="4" fill="#e1061a" />
                    </svg>
                </div>

                <!-- Apunte 4: Seguridad (Abajo Derecha) -->
                <div class="absolute top-[70%] right-[-15%] text-left w-[320px]">
                    <div class="bg-white p-4 rounded-xl shadow-lg border border-slate-100 inline-block pointer-events-auto hover:-translate-y-1 transition-transform">
                        <div class="flex items-center gap-2 mb-1 justify-start">
                            <div class="w-2 h-2 rounded-full bg-corporate-red"></div>
                            <h4 class="font-headings font-bold text-deep-charcoal">Seguridad Encriptada</h4>
                        </div>
                        <p class="font-sans text-xs text-slate-500">Prevención de clonación para control de acceso y cobros seguros.</p>
                    </div>
